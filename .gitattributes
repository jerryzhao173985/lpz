# Git attributes for LPZRobots - Essential for cross-platform C++ development

# Critical: Normalize line endings to LF for cross-platform compatibility
* text=auto eol=lf

# C++ source files
*.cpp text diff=cpp
*.c text diff=cpp
*.h text diff=cpp
*.hpp text diff=cpp

# Critical: Preserve exact formatting in build files
Makefile* -text
*.mk -text
*.m4 -text

# Scripts must have LF endings
*.sh text eol=lf

# Binary files - prevent corruption
*.o binary
*.a binary
*.so binary
*.dylib binary
*.dll binary
*.exe binary

# Windows batch files need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf