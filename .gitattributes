# Git attributes for LPZRobots project
# Ensures consistent handling of line endings and file types across platforms

# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Source files
*.cpp text diff=cpp
*.cc text diff=cpp
*.cxx text diff=cpp
*.c text diff=cpp
*.h text diff=cpp
*.hpp text diff=cpp
*.hxx text diff=cpp
*.hh text diff=cpp

# Qt files
*.pro text
*.pri text
*.prf text
*.prl text
*.ui text
*.qrc text

# Build files
*.cmake text
CMakeLists.txt text
Makefile text
*.mk text
*.mak text
GNUmakefile text
*.m4 text

# Script files
*.sh text eol=lf
*.bash text eol=lf
*.py text diff=python
*.pl text diff=perl
*.rb text diff=ruby

# Configuration files
*.json text
*.xml text
*.yml text
*.yaml text
*.toml text
*.ini text
*.conf text
*.cfg text
.editorconfig text
.gitignore text
.gitattributes text
.clang-format text
.clang-tidy text
.pre-commit-config.yaml text

# Documentation
*.md text diff=markdown
*.txt text
*.rst text
*.tex text diff=tex
README* text
LICENSE* text
CHANGELOG* text
AUTHORS* text
CONTRIBUTING* text
INSTALL* text
NEWS* text
TODO* text

# Web files
*.html text diff=html
*.css text diff=css
*.js text diff=javascript
*.svg text

# Data files
*.csv text
*.tsv text
*.dat text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.eps binary

# Compiled binaries
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.a binary
*.lib binary
*.o binary
*.obj binary
*.class binary
*.jar binary

# Compressed files
*.gz binary
*.zip binary
*.tar binary
*.tgz binary
*.bz2 binary
*.xz binary
*.7z binary
*.rar binary

# Media files
*.mp3 binary
*.mp4 binary
*.avi binary
*.mov binary
*.wav binary
*.ogg binary

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary

# Model/Data files
*.stl binary
*.obj binary
*.dae binary
*.3ds binary
*.blend binary

# IDE specific files
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.pbxproj binary
*.xcworkspace binary
*.xcscheme text

# Special handling for Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Linguist language detection overrides
*.h linguist-language=C++
*.inc linguist-language=C++

# Files that should not be exported in archives
.gitattributes export-ignore
.gitignore export-ignore
.pre-commit-config.yaml export-ignore
.github/ export-ignore
.vscode/ export-ignore
.idea/ export-ignore
.clang-tidy export-ignore
.clang-format export-ignore
.editorconfig export-ignore

# Large files that might benefit from LFS (if you decide to use it)
# Uncomment if using Git LFS
# *.pdf filter=lfs diff=lfs merge=lfs -text
# *.png filter=lfs diff=lfs merge=lfs -text
# *.jpg filter=lfs diff=lfs merge=lfs -text
# *.stl filter=lfs diff=lfs merge=lfs -text