# LPZRobots .gitignore
# Comprehensive gitignore for C++, Qt, CMake, and Make projects
# Last updated: 2025-01-06 with deep codebase scan

#=============================================================================
# Build directories (CRITICAL - many found in repo)
#=============================================================================

# All build directories regardless of naming
build/
build-*/
build_*/
cmake-build-*/
out/
bin/
lib/
obj/
dist/

# Specific build directories found in scan
build-test/
build-final-test/
build-verification/
build_test/
build_dbg/
build_opt/
build_logs/

#=============================================================================
# CMake generated files and directories
#=============================================================================

# CMake cache and generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/
CMakeUserPresets.json
Testing/
DartConfiguration.tcl

# CMake build directories
CMakeBuilds/
cmake-build-debug/
cmake-build-release/

# CPack generated files
_CPack_Packages/
CPack*.cmake
CPackConfig.cmake
CPackSourceConfig.cmake

# Generated export files
*Config.cmake
*ConfigVersion.cmake
*Targets.cmake
!*Config.cmake.in
!*ConfigVersion.cmake.in

#=============================================================================
# Build artifacts and binaries
#=============================================================================

# Object files
*.o
*.obj

# Dependency files (MANY found: main.d, etc.)
*.d

# Libraries (CRITICAL - many in component dirs)
*.a
*.la
*.lai
*.lo
*.so
*.so.*
*.dylib
*.dll
*.lib
*.exp

# Static libraries in component directories
selforg/libselforg*.a
selforg/libselforg*.so
ga_tools/libga_tools*.a
ode_robots/libode_robots*.a
ode_robots/libode_robots*.so
configurator/libconfigurator*.dylib
configurator/libconfigurator*.a
opende/lib*.a

# Executables
*.exe
*.out
start
start_*

# Test executables (many found without extension)
test_*
!test_*.cpp
!test_*.h
!test_*.sh
debug_*
!debug_*.cpp

# macOS application bundles
*.app/
*.dSYM/

# Windows debug files
*.pdb
*.ilk
*.map
*.exp

#=============================================================================
# Qt generated files (EXTENSIVE in project)
#=============================================================================

# Qt MOC files
moc_*.cpp
moc_*.h
*.moc
moc/
*_automoc.cpp

# Qt UI files
ui_*.h

# Qt resource files
qrc_*.cpp
*.qrc.depends

# Qt build files
.qmake.cache
.qmake.stash
*.pro.user
*.pro.user.*
*.qbs.user
*.qbs.user.*
*.qmlc
*.jsc

# Qt autogen directories (MANY found)
*_autogen/
*_autogen
moc_predefs.h

# Generated Makefiles from qmake
guilogger/Makefile
guilogger/src/Makefile
matrixviz/Makefile
matrixviz/src/Makefile
configurator/Makefile
configurator/src/Makefile
configurator/src-qt/Makefile

#=============================================================================
# Make/Autotools generated files
#=============================================================================

# Configuration files (CRITICAL - generated by configure scripts)
Makefile.conf
Makefile.conf.bak
Makefile.depend
config.status
config.log
config.h
config.h.in~
stamp-h1

# Component-specific Makefile.conf
ecbrobots/Makefile.conf
ga_tools/Makefile.conf
ode_robots/Makefile.conf
selforg/Makefile.conf
opende/Makefile.conf
guilogger/Makefile.conf
matrixviz/Makefile.conf
configurator/Makefile.conf

# M4 and autotools
autom4te.cache/
aclocal.m4
configure~

# Generated dependency files
*.dep
.deps/
.dirstamp

#=============================================================================
