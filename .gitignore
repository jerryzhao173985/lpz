configurator/*.a

# Guilogger specific
guilogger/Makefile.conf
guilogger/*.a

# Matrixviz specific
matrixviz/Makefile.conf
matrixviz/*.a

#=============================================================================
# Files that should be kept (exceptions)
#=============================================================================

# Keep specific configuration templates
!Makefile.conf.example
!CMakePresets.json
!.clang-format
!.clang-tidy
!.editorconfig
!.gitattributes

# Keep documentation
!*.md
!LICENSE
!COPYING
!AUTHORS
!README*
!INSTALL*
!NEWS
!CHANGELOG*

# Keep CI configuration
!.github/
!.gitlab-ci.yml
!.travis.yml
!appveyor.yml

# Keep docker files
!Dockerfile*
!docker-compose*.yml
!.dockerignore

#=============================================================================
# IDE/editor backup artifacts (Added 2025-07-12 to fix CI failures)
#=============================================================================

# IDE/editor backup artifacts
.!*!.*
*~
