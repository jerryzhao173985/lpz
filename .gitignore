tags
GTAGS
GRTAGS
GPATH
cscope.*

# Generated configuration scripts
*-config
!*-config.in
!*-config.m4
!*-config.sh.in

# Component library files in source directories
libselforg*
libode_robots*
libga_tools*
libconfigurator*
!*/lib*/  # But allow lib directories

# Simulation data files
*.dat
*.ctrl
*.matrix
*.sim
*.log

# Video recordings
video0*
*.avi
*.mp4
*.mpg
*.mov

# Include directory (generated by build)
/include/
# Generated symlinks in selforg
selforg/include/selforg/matrix/
selforg/include/selforg/*.tests.hpp
selforg/include/selforg/unit_test.hpp

# External dependencies (if downloaded)
dependencies/
vendor/
third_party/
external/
downloads/

# Package files
*.deb
*.rpm
*.dmg
*.pkg
*.msi

# Archives
*.tar
*.tar.gz
*.tgz
*.tar.bz2
*.tbz2
*.tar.xz
*.txz
*.zip
*.7z
*.rar
*.gz
*.bz2
*.xz

# Patch files (except intentional ones)
*.patch
*.diff
