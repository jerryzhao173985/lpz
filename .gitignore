!patches/*.diff

# Backup directories
backup/
backups/
old/
pre_cleanup_backup*.tar.gz

# Distribution directories
dist/
distribute/

# lpz-build symlink
lpz-build

# Test sanitizer executables
test_sanitizers
*_asan
*_tsan
*_ubsan

# Generated configuration files
Makefile.conf
config.h
config.status
config.log
stamp-h1
libtool
configure.scan

# Autotools cache
autom4te.cache/
.deps/
.libs/

# M4 generated files
aclocal.m4
configure~
config.h.in~

#=============================================================================
# Component-specific ignores
#=============================================================================

# ECBRobots specific
ecbrobots/simulations/*/start
ecbrobots/simulations/*/start.app/
ecbrobots/simulations/*/.qmake.stash
ecbrobots/Makefile.conf
ecbrobots/*.a

# Examples executables (many found)
selforg/examples/test_*
selforg/examples/debug_*
!selforg/examples/test_*.cpp
!selforg/examples/debug_*.cpp
selforg/examples/*.d
selforg/examples/integration/*.d
selforg/examples/directconnect/*.d
selforg/examples/matrix/*.d

# GA tools specific
ga_tools/simulations/*/start
ga_tools/build.log
ga_tools/Makefile.conf
ga_tools/*.a

# ODE specific
opende/drawstuff/dstest/dstest
opende/tests/tests
opende/demo/demo_*
