{
    "version": "0.2.0",
    "configurations": [
        // ╔══════════════════════════════════════════════════════════════════╗
        // ║                    GENERAL DEBUG CONFIGURATIONS                   ║
        // ╚══════════════════════════════════════════════════════════════════╝
        
        {
            "name": "🐛 Debug: Current CMake Target",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${command:cmake.launchTargetDirectory}",
            "environment": [
                {
                    "name": "DYLD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/build/${command:cmake.buildPresetName}/lib:${workspaceFolder}/build/${command:cmake.buildPresetName}/selforg:${workspaceFolder}/build/${command:cmake.buildPresetName}/ode_robots:${workspaceFolder}/build/${command:cmake.buildPresetName}/ga_tools"
                },
                {
                    "name": "LPZROBOTS_DEBUG",
                    "value": "1"
                }
            ],
            "externalConsole": false,
            "MIMode": "lldb",
            "osx": {
                "MIMode": "lldb",
                "setupCommands": [
                    {
                        "description": "Load LPZRobots debug visualizers",
                        "text": "command script import ${workspaceFolder}/.vscode/debugvis/lpzrobots_lldb.py",
                        "ignoreFailures": true
                    },
                    {
                        "description": "Enable pretty-printing",
                        "text": "-enable-pretty-printing",
                        "ignoreFailures": true
                    },
                    {
                        "description": "Set print elements",
                        "text": "settings set target.max-children-count 200",
                        "ignoreFailures": true
                    },
                    {
                        "description": "Enable synthetic values",
                        "text": "settings set target.enable-synthetic-value true",
                        "ignoreFailures": true
                    }
                ]
            },
            "linux": {
                "MIMode": "gdb",
                "setupCommands": [
                    {
                        "description": "Load LPZRobots debug visualizers",
                        "text": "source ${workspaceFolder}/.vscode/debugvis/.gdbinit",
                        "ignoreFailures": true
                    },
                    {
                        "description": "Enable pretty-printing",
                        "text": "-enable-pretty-printing",
                        "ignoreFailures": true
                    },
                    {
                        "description": "Set print elements",
                        "text": "set print elements 200",
                        "ignoreFailures": true
                    },
                    {
                        "description": "Set print array on",
                        "text": "set print array on",
                        "ignoreFailures": true
                    }
                ]
            },
            "preLaunchTask": "🔨 Build: Current Component",
            "logging": {
                "moduleLoad": false,
                "engineLogging": false,
                "trace": false
            }
        },
        
        // ╔══════════════════════════════════════════════════════════════════╗
        // ║                  COMPONENT DEBUG CONFIGURATIONS                   ║
        // ╚══════════════════════════════════════════════════════════════════╝
        
        {
            "name": "🧠 Debug: selforg Tests",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/${command:cmake.buildPresetName}/tests/test_selforg",
            "args": ["--success", "--duration", "--reporter=console"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/${command:cmake.buildPresetName}/tests",
            "environment": [
                {
                    "name": "DYLD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/build/${command:cmake.buildPresetName}/selforg"
                }
            ],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "📦 Component: Build selforg"
        },
        {
            "name": "🤖 Debug: ode_robots Component",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/${command:cmake.buildPresetName}/tests/test_ode_robots",
            "args": ["--success", "--duration"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/${command:cmake.buildPresetName}/tests",
            "environment": [
                {
                    "name": "DYLD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/build/${command:cmake.buildPresetName}/selforg:${workspaceFolder}/build/${command:cmake.buildPresetName}/ode_robots"
                },
                {
                    "name": "OSG_LIBRARY_PATH",
                    "value": "${env:HOMEBREW_PREFIX:/opt/homebrew}/lib"
                }
            ],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "📦 Component: Build ode_robots"
        },
        {
            "name": "🧬 Debug: ga_tools",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/${command:cmake.buildPresetName}/ga_tools/examples/genetic_example",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/${command:cmake.buildPresetName}/ga_tools",
            "environment": [
                {
                    "name": "DYLD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/build/${command:cmake.buildPresetName}/selforg:${workspaceFolder}/build/${command:cmake.buildPresetName}/ga_tools"
                }
            ],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "📦 Component: Build ga_tools"
        },
        
        // ╔══════════════════════════════════════════════════════════════════╗
        // ║                 SIMULATION DEBUG CONFIGURATIONS                   ║
        // ╚══════════════════════════════════════════════════════════════════╝
        
        {
            "name": "🌐 Debug: Simulation (Basic)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/${command:cmake.buildPresetName}/ode_robots/simulations/${input:simulationName}/start",
            "args": ["-noshadow", "-nohud"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/${command:cmake.buildPresetName}/ode_robots/simulations/${input:simulationName}",
            "environment": [
                {
                    "name": "DYLD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/build/${command:cmake.buildPresetName}/lib:${workspaceFolder}/build/${command:cmake.buildPresetName}/selforg:${workspaceFolder}/build/${command:cmake.buildPresetName}/ode_robots"
                },
                {
                    "name": "LPZROBOTS_DEBUG_EVENTS",
                    "value": "${input:debugEvents}"
                }
            ],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "🤖 Simulation: Build Current",
            "postDebugTask": "🧹 Clean: Build Directory"
        },
        {
            "name": "🌐 Debug: Simulation + GUI Tools",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/${command:cmake.buildPresetName}/ode_robots/simulations/${input:simulationName}/start",
            "args": ["-noshadow", "-g", "5", "-m", "10", "-conf"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/${command:cmake.buildPresetName}/ode_robots/simulations/${input:simulationName}",
            "environment": [
                {
                    "name": "DYLD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/build/${command:cmake.buildPresetName}/lib"
                },
                {
                    "name": "PATH",
                    "value": "${workspaceFolder}/build/${command:cmake.buildPresetName}/guilogger:${workspaceFolder}/build/${command:cmake.buildPresetName}/matrixviz:${workspaceFolder}/build/${command:cmake.buildPresetName}/configurator:${env:PATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "📦 Component: Build GUI Tools"
        },
        {
            "name": "🌐 Debug: Headless Simulation",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/${command:cmake.buildPresetName}/ode_robots/simulations/${input:simulationName}/start",
            "args": ["-nographics", "-noshadow", "-r", "${input:runSteps}"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/${command:cmake.buildPresetName}/ode_robots/simulations/${input:simulationName}",
            "environment": [
                {
                    "name": "DYLD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/build/${command:cmake.buildPresetName}/lib"
                }
            ],
            "externalConsole": false,
            "MIMode": "lldb"
        },
        
        // ╔══════════════════════════════════════════════════════════════════╗
        // ║                  SANITIZER DEBUG CONFIGURATIONS                   ║
        // ╚══════════════════════════════════════════════════════════════════╝
        
        {
            "name": "🔍 Debug: AddressSanitizer",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": ["-noshadow", "-r", "100"],
            "stopAtEntry": false,
            "cwd": "${command:cmake.launchTargetDirectory}",
            "environment": [
                {
                    "name": "DYLD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/build/dev-sanitizers/lib"
                },
                {
                    "name": "ASAN_OPTIONS",
                    "value": "detect_leaks=1:check_initialization_order=1:strict_init_order=1:print_stats=1:halt_on_error=0:symbolize=1:color=always:print_module_map=1"
                },
                {
                    "name": "ASAN_SYMBOLIZER_PATH",
                    "value": "${env:HOMEBREW_PREFIX:/opt/homebrew}/opt/llvm/bin/llvm-symbolizer"
                },
                {
                    "name": "MallocNanoZone",
                    "value": "0"
                }
            ],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "🔧 Configure: Dev (Sanitizers)",
            "setupCommands": [
                {
                    "description": "Disable ASAN error stopping in debugger",
                    "text": "settings set target.process.stop-on-exec false",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "🔍 Debug: ThreadSanitizer",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": ["-noshadow", "-odethread", "4"],
            "stopAtEntry": false,
            "cwd": "${command:cmake.launchTargetDirectory}",
            "environment": [
                {
                    "name": "DYLD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/build/dev-sanitizers/lib"
                },
                {
                    "name": "TSAN_OPTIONS",
                    "value": "halt_on_error=0:history_size=7:second_deadlock_stack=1:color=always"
                }
            ],
            "externalConsole": false,
            "MIMode": "lldb"
        },
        {
            "name": "🔍 Debug: UndefinedBehaviorSanitizer",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": ["-noshadow"],
            "stopAtEntry": false,
            "cwd": "${command:cmake.launchTargetDirectory}",
            "environment": [
                {
                    "name": "DYLD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/build/dev-sanitizers/lib"
                },
                {
                    "name": "UBSAN_OPTIONS",
                    "value": "print_stacktrace=1:halt_on_error=0:color=always:suppressions=${workspaceFolder}/.ubsan_suppressions"
                }
            ],
            "externalConsole": false,
            "MIMode": "lldb"
        },
        
        // ╔══════════════════════════════════════════════════════════════════╗
        // ║                   GUI TOOL DEBUG CONFIGURATIONS                   ║
        // ╚══════════════════════════════════════════════════════════════════╝
        
        {
            "name": "📊 Debug: guilogger",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/${command:cmake.buildPresetName}/guilogger/bin/guilogger",
            "args": ["-m", "pipe", "-l", "${input:logFile}"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "QT_DEBUG_PLUGINS",
                    "value": "1"
                }
            ],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "📦 Component: Build GUI Tools"
        },
        {
            "name": "🔲 Debug: matrixviz",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/${command:cmake.buildPresetName}/matrixviz/bin/matrixviz",
            "args": ["-m", "pipe"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "QT_DEBUG_PLUGINS",
                    "value": "1"
                }
            ],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "📦 Component: Build GUI Tools"
        },
        {
            "name": "⚙️ Debug: configurator",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/${command:cmake.buildPresetName}/configurator/bin/configurator",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "QT_DEBUG_PLUGINS",
                    "value": "1"
                },
                {
                    "name": "DYLD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/build/${command:cmake.buildPresetName}/selforg"
                }
            ],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "📦 Component: Build GUI Tools"
        },
        
        // ╔══════════════════════════════════════════════════════════════════╗
        // ║                    ATTACH CONFIGURATIONS                          ║
        // ╚══════════════════════════════════════════════════════════════════╝
        
        {
            "name": "📎 Attach: Running Process",
            "type": "cppdbg",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "MIMode": "lldb",
            "setupCommands": [
                {
                    "description": "Enable debugging of system libraries",
                    "text": "settings set target.process.follow-fork-mode child",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "📎 Attach: Remote Simulation",
            "type": "cppdbg",
            "request": "attach",
            "processId": "${input:remoteProcessId}",
            "MIMode": "gdb",
            "miDebuggerServerAddress": "${input:remoteAddress}",
            "program": "${workspaceFolder}/build/${command:cmake.buildPresetName}/ode_robots/simulations/${input:simulationName}/start"
        },
        
        // ╔══════════════════════════════════════════════════════════════════╗
        // ║                  SPECIAL DEBUG CONFIGURATIONS                     ║
        // ╚══════════════════════════════════════════════════════════════════╝
        
        {
            "name": "💥 Debug: Core Dump",
            "type": "cppdbg",
            "request": "launch",
            "program": "${input:programPath}",
            "coreDumpPath": "${input:coreDumpPath}",
            "cwd": "${workspaceFolder}",
            "MIMode": "lldb",
            "setupCommands": [
                {
                    "description": "Load all symbols",
                    "text": "target symbols add ${workspaceFolder}/build/${command:cmake.buildPresetName}/**/*.dSYM",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "📈 Profile: Performance",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": ["-noshadow", "-r", "1000"],
            "stopAtEntry": false,
            "cwd": "${command:cmake.launchTargetDirectory}",
            "environment": [
                {
                    "name": "DYLD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/build/release/lib"
                },
                {
                    "name": "CPUPROFILE",
                    "value": "${workspaceFolder}/profiles/${fileBasenameNoExtension}.prof"
                }
            ],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "🔨 Build: All",
            "postDebugTask": "📊 Show Build Statistics"
        }
    ],
    
    // ╔══════════════════════════════════════════════════════════════════╗
    // ║                   COMPOUND CONFIGURATIONS                         ║
    // ╚══════════════════════════════════════════════════════════════════╝
    
    "compounds": [
        {
            "name": "🎯 Simulation + All GUI Tools",
            "configurations": [
                "🌐 Debug: Simulation + GUI Tools",
                "📊 Debug: guilogger",
                "🔲 Debug: matrixviz",
                "⚙️ Debug: configurator"
            ],
            "stopAll": true,
            "preLaunchTask": "🚀 Workflow: Simulation Development"
        },
        {
            "name": "🔬 All Sanitizers",
            "configurations": [
                "🔍 Debug: AddressSanitizer",
                "🔍 Debug: UndefinedBehaviorSanitizer"
            ],
            "stopAll": true,
            "preLaunchTask": "🔧 Configure: Dev (Sanitizers)"
        },
        {
            "name": "🧪 Component Tests",
            "configurations": [
                "🧠 Debug: selforg Tests",
                "🤖 Debug: ode_robots Component",
                "🧬 Debug: ga_tools"
            ],
            "stopAll": false,
            "preLaunchTask": "🚀 Workflow: Build and Test"
        },
        {
            "name": "🖼️ Multi-Simulation Debug",
            "configurations": [
                {
                    "name": "Sim 1",
                    "configuration": "🌐 Debug: Simulation (Basic)"
                },
                {
                    "name": "Sim 2",
                    "configuration": "🌐 Debug: Simulation (Basic)"
                }
            ],
            "stopAll": true
        }
    ],
    
    // ╔══════════════════════════════════════════════════════════════════╗
    // ║                      INPUT VARIABLES                              ║
    // ╚══════════════════════════════════════════════════════════════════╝
    
    "inputs": [
        {
            "id": "simulationName",
            "type": "promptString",
            "description": "Enter simulation name",
            "default": "template_sphererobot"
        },
        {
            "id": "runSteps",
            "type": "promptString",
            "description": "Number of simulation steps",
            "default": "1000"
        },
        {
            "id": "debugEvents",
            "type": "pickString",
            "description": "Enable debug events?",
            "options": ["0", "1"],
            "default": "0"
        },
        {
            "id": "logFile",
            "type": "promptString",
            "description": "Log file path (optional)",
            "default": ""
        },
        {
            "id": "programPath",
            "type": "promptString",
            "description": "Path to the program executable",
            "default": "${workspaceFolder}/build/default/ode_robots/simulations/template_sphererobot/start"
        },
        {
            "id": "coreDumpPath",
            "type": "promptString",
            "description": "Path to the core dump file",
            "default": "/cores/core.*"
        },
        {
            "id": "remoteAddress",
            "type": "promptString",
            "description": "Remote debugger address (host:port)",
            "default": "localhost:2345"
        },
        {
            "id": "remoteProcessId",
            "type": "promptString",
            "description": "Remote process ID",
            "default": "1234"
        }
    ]
}