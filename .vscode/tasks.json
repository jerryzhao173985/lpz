{
    "version": "2.0.0",
    "tasks": [
        // ╔══════════════════════════════════════════════════════════════════╗
        // ║                    CMAKE CONFIGURATION TASKS                      ║
        // ╚══════════════════════════════════════════════════════════════════╝
        
        {
            "label": "🔧 Configure: Auto-detect Platform",
            "type": "shell",
            "command": "cmake",
            "args": ["--preset=${input:cmakePreset}"],
            "group": "build",
            "problemMatcher": [],
            "detail": "Configure with selected preset",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "🔧 Configure: macOS ARM64",
            "type": "shell",
            "command": "cmake",
            "args": ["--preset=macos-arm64"],
            "group": "build",
            "problemMatcher": [],
            "detail": "Configure for macOS ARM64 (Apple Silicon)"
        },
        {
            "label": "🔧 Configure: Linux",
            "type": "shell",
            "command": "cmake",
            "args": ["--preset=linux"],
            "group": "build",
            "problemMatcher": [],
            "detail": "Configure for Linux x86_64"
        },
        {
            "label": "🔧 Configure: Debug",
            "type": "shell",
            "command": "cmake",
            "args": ["--preset=debug"],
            "group": "build",
            "problemMatcher": [],
            "detail": "Configure with debug symbols and no optimization"
        },
        {
            "label": "🔧 Configure: Release",
            "type": "shell",
            "command": "cmake",
            "args": ["--preset=release"],
            "group": "build",
            "problemMatcher": [],
            "detail": "Configure with full optimization"
        },
        {
            "label": "🔧 Configure: Dev (Sanitizers)",
            "type": "shell",
            "command": "cmake",
            "args": ["--preset=dev-sanitizers"],
            "group": "build",
            "problemMatcher": [],
            "detail": "Configure with AddressSanitizer and UndefinedBehaviorSanitizer",
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "echo": true
            }
        },
        {
            "label": "🔧 Configure: Minimal (Core Only)",
            "type": "shell",
            "command": "cmake",
            "args": ["--preset=minimal"],
            "group": "build",
            "problemMatcher": [],
            "detail": "Configure with only core components (no GUI)"
        },
        
        // ╔══════════════════════════════════════════════════════════════════╗
        // ║                        BUILD TASKS                                ║
        // ╚══════════════════════════════════════════════════════════════════╝
        
        {
            "label": "🔨 Build: All",
            "type": "cmake",
            "command": "build",
            "targets": ["all"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Build all targets with current preset"
        },
        {
            "label": "🔨 Build: Current Component",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/scripts/build-current-component.sh",
            "args": ["${relativeFile}"],
            "group": "build",
            "problemMatcher": ["$gcc"],
            "detail": "Build the component containing the current file"
        },
        {
            "label": "🔨 Build: Quick (Changed Only)",
            "type": "cmake",
            "command": "build",
            "problemMatcher": ["$gcc"],
            "detail": "Build only changed targets",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        
        // ╔══════════════════════════════════════════════════════════════════╗
        // ║                    COMPONENT BUILD TASKS                          ║
        // ╚══════════════════════════════════════════════════════════════════╝
        
        {
            "label": "📦 Component: Build selforg",
            "type": "cmake",
            "command": "build",
            "targets": ["selforg", "selforg_tests"],
            "group": "build",
            "problemMatcher": ["$gcc"],
            "detail": "Build selforg library and its tests",
            "icon": {
                "id": "library",
                "color": "terminal.ansiBlue"
            }
        },
        {
            "label": "📦 Component: Build ode_robots",
            "type": "cmake",
            "command": "build",
            "targets": ["ode_robots"],
            "group": "build",
            "problemMatcher": ["$gcc"],
            "detail": "Build ode_robots library",
            "dependsOn": ["📦 Component: Build selforg"],
            "icon": {
                "id": "robot",
                "color": "terminal.ansiGreen"
            }
        },
        {
            "label": "📦 Component: Build ga_tools",
            "type": "cmake",
            "command": "build",
            "targets": ["ga_tools"],
            "group": "build",
            "problemMatcher": ["$gcc"],
            "detail": "Build genetic algorithm tools",
            "dependsOn": ["📦 Component: Build selforg"],
            "icon": {
                "id": "beaker",
                "color": "terminal.ansiYellow"
            }
        },
        {
            "label": "📦 Component: Build GUI Tools",
            "type": "cmake",
            "command": "build",
            "targets": ["guilogger", "matrixviz", "configurator"],
            "group": "build",
            "problemMatcher": ["$gcc"],
            "detail": "Build all GUI visualization tools",
            "icon": {
                "id": "eye",
                "color": "terminal.ansiMagenta"
            }
        },
        
        // ╔══════════════════════════════════════════════════════════════════╗
        // ║                     SIMULATION TASKS                              ║
        // ╚══════════════════════════════════════════════════════════════════╝
        
        {
            "label": "🤖 Simulation: Build Current",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", 
                "${workspaceFolder}/build/${config:cmake.buildDirectory}",
                "--target",
                "${input:simulationName}"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"],
            "detail": "Build selected simulation"
        },
        {
            "label": "🤖 Simulation: Run with GUI",
            "type": "shell",
            "command": "${workspaceFolder}/build/${config:cmake.buildDirectory}/ode_robots/simulations/${input:simulationName}/start",
            "args": ["-noshadow", "-g", "5", "-m", "10"],
            "options": {
                "cwd": "${workspaceFolder}/build/${config:cmake.buildDirectory}/ode_robots/simulations/${input:simulationName}",
                "env": {
                    "DYLD_LIBRARY_PATH": "${workspaceFolder}/build/${config:cmake.buildDirectory}/lib",
                    "LPZROBOTS_DEBUG_EVENTS": "0"
                }
            },
            "group": "test",
            "problemMatcher": [],
            "detail": "Run simulation with guilogger and matrixviz",
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true
            }
        },
        {
            "label": "🤖 Simulation: Run with Configurator",
            "type": "shell",
            "command": "${workspaceFolder}/build/${config:cmake.buildDirectory}/ode_robots/simulations/${input:simulationName}/start",
            "args": ["-noshadow", "-g", "5", "-m", "10", "-conf"],
            "options": {
                "cwd": "${workspaceFolder}/build/${config:cmake.buildDirectory}/ode_robots/simulations/${input:simulationName}"
            },
            "group": "test",
            "problemMatcher": [],
            "detail": "Run simulation with all GUI tools including configurator"
        },
        {
            "label": "🤖 Simulation: Headless (No Graphics)",
            "type": "shell",
            "command": "${workspaceFolder}/build/${config:cmake.buildDirectory}/ode_robots/simulations/${input:simulationName}/start",
            "args": ["-nographics", "-noshadow", "-r", "1000"],
            "options": {
                "cwd": "${workspaceFolder}/build/${config:cmake.buildDirectory}/ode_robots/simulations/${input:simulationName}"
            },
            "group": "test",
            "problemMatcher": [],
            "detail": "Run simulation without graphics for 1000 steps"
        },
        {
            "label": "🤖 Simulation: Create New",
            "type": "shell",
            "command": "${workspaceFolder}/ode_robots/simulations/createNewSimulation.sh",
            "args": ["${input:templateName}", "${input:newSimulationName}"],
            "options": {
                "cwd": "${workspaceFolder}/ode_robots/simulations"
            },
            "group": "build",
            "problemMatcher": [],
            "detail": "Create a new simulation from template"
        },
        
        // ╔══════════════════════════════════════════════════════════════════╗
        // ║                        TEST TASKS                                 ║
        // ╚══════════════════════════════════════════════════════════════════╝
        
        {
            "label": "🧪 Test: All",
            "type": "cmake",
            "command": "test",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [],
            "detail": "Run all CTest tests"
        },
        {
            "label": "🧪 Test: Component",
            "type": "shell",
            "command": "ctest",
            "args": [
                "--test-dir", "${workspaceFolder}/build/${config:cmake.buildDirectory}",
                "-R", "${input:componentName}",
                "--output-on-failure",
                "--parallel", "8"
            ],
            "group": "test",
            "problemMatcher": [],
            "detail": "Run tests for specific component"
        },
        {
            "label": "🧪 Test: With Coverage",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build/${config:cmake.buildDirectory}",
                "--target", "coverage"
            ],
            "group": "test",
            "problemMatcher": [],
            "detail": "Run tests and generate coverage report"
        },
        {
            "label": "🧪 Test: Memory Check",
            "type": "shell",
            "command": "ctest",
            "args": [
                "--test-dir", "${workspaceFolder}/build/${config:cmake.buildDirectory}",
                "-T", "memcheck",
                "--output-on-failure"
            ],
            "group": "test",
            "problemMatcher": [],
            "detail": "Run tests with valgrind memory checking"
        },
        
        // ╔══════════════════════════════════════════════════════════════════╗
        // ║                    CODE QUALITY TASKS                             ║
        // ╚══════════════════════════════════════════════════════════════════╝
        
        {
            "label": "✨ Format: Current File",
            "type": "shell",
            "command": "${env:HOMEBREW_PREFIX:/opt/homebrew}/opt/llvm/bin/clang-format",
            "args": ["-i", "${file}"],
            "group": "none",
            "problemMatcher": [],
            "detail": "Format current file with clang-format",
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "✨ Format: All Changed Files",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "git diff --name-only --diff-filter=ACMRT HEAD | grep -E '\\.(cpp|h|hpp|cc|cxx)$' | xargs -I {} ${env:HOMEBREW_PREFIX:/opt/homebrew}/opt/llvm/bin/clang-format -i {}"
            ],
            "group": "none",
            "problemMatcher": [],
            "detail": "Format all modified C++ files"
        },
        {
            "label": "🔍 Analyze: Current File",
            "type": "shell",
            "command": "${env:HOMEBREW_PREFIX:/opt/homebrew}/opt/llvm/bin/clang-tidy",
            "args": [
                "${file}",
                "--config-file=${workspaceFolder}/.clang-tidy",
                "-p", "${workspaceFolder}/build/${config:cmake.buildDirectory}"
            ],
            "group": "none",
            "problemMatcher": ["$gcc"],
            "detail": "Run clang-tidy on current file"
        },
        {
            "label": "🔍 Analyze: Component",
            "type": "shell",
            "command": "${env:HOMEBREW_PREFIX:/opt/homebrew}/opt/llvm/bin/run-clang-tidy",
            "args": [
                "-p", "${workspaceFolder}/build/${config:cmake.buildDirectory}",
                "-config-file=${workspaceFolder}/.clang-tidy",
                "-j", "8",
                "${workspaceFolder}/${input:componentName}"
            ],
            "group": "none",
            "problemMatcher": ["$gcc"],
            "detail": "Run clang-tidy on entire component"
        },
        {
            "label": "🔍 Check: Include What You Use",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build/${config:cmake.buildDirectory}",
                "--target", "iwyu"
            ],
            "group": "none",
            "problemMatcher": ["$gcc"],
            "detail": "Check for unnecessary includes"
        },
        
        // ╔══════════════════════════════════════════════════════════════════╗
        // ║                    WORKFLOW TASKS                                 ║
        // ╚══════════════════════════════════════════════════════════════════╝
        
        {
            "label": "🚀 Workflow: Clean Build",
            "dependsOrder": "sequence",
            "dependsOn": [
                "🧹 Clean: All",
                "🔧 Configure: Auto-detect Platform",
                "🔨 Build: All"
            ],
            "group": "build",
            "detail": "Clean, configure, and build everything"
        },
        {
            "label": "🚀 Workflow: Build and Test",
            "dependsOrder": "sequence",
            "dependsOn": [
                "🔨 Build: All",
                "🧪 Test: All"
            ],
            "group": "test",
            "detail": "Build all targets and run tests"
        },
        {
            "label": "🚀 Workflow: Format and Analyze",
            "dependsOrder": "parallel",
            "dependsOn": [
                "✨ Format: All Changed Files",
                "🔍 Analyze: Current File"
            ],
            "group": "none",
            "detail": "Format code and run static analysis"
        },
        {
            "label": "🚀 Workflow: Simulation Development",
            "dependsOrder": "sequence",
            "dependsOn": [
                "📦 Component: Build ode_robots",
                "🤖 Simulation: Build Current",
                "🤖 Simulation: Run with GUI"
            ],
            "group": "test",
            "detail": "Build and run simulation with GUI tools"
        },
        
        // ╔══════════════════════════════════════════════════════════════════╗
        // ║                    UTILITY TASKS                                  ║
        // ╚══════════════════════════════════════════════════════════════════╝
        
        {
            "label": "🧹 Clean: All",
            "type": "cmake",
            "command": "clean",
            "group": "build",
            "problemMatcher": [],
            "detail": "Clean all build artifacts"
        },
        {
            "label": "🧹 Clean: Build Directory",
            "type": "shell",
            "command": "rm",
            "args": ["-rf", "${workspaceFolder}/build/${config:cmake.buildDirectory}"],
            "group": "build",
            "problemMatcher": [],
            "detail": "Remove entire build directory"
        },
        {
            "label": "🧹 Clean and Rebuild",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "cmake --build '${workspaceFolder}/build/${config:cmake.buildDirectory}' --target clean && cmake --build '${workspaceFolder}/build/${config:cmake.buildDirectory}' --parallel"],
            "group": "build",
            "problemMatcher": ["$gcc"],
            "detail": "Clean and rebuild everything"
        },
        {
            "label": "📥 Install",
            "type": "cmake",
            "command": "install",
            "group": "build",
            "problemMatcher": [],
            "detail": "Install to CMAKE_INSTALL_PREFIX"
        },
        {
            "label": "📚 Generate Documentation",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build/${config:cmake.buildDirectory}",
                "--target", "doc"
            ],
            "group": "none",
            "problemMatcher": [],
            "detail": "Generate Doxygen documentation"
        },
        {
            "label": "📊 Show Build Statistics",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build/${config:cmake.buildDirectory}",
                "--target", "stats"
            ],
            "group": "none",
            "problemMatcher": [],
            "detail": "Show build time and size statistics"
        },
        
        // ╔══════════════════════════════════════════════════════════════════╗
        // ║                    LEGACY MAKE TASKS                              ║
        // ╚══════════════════════════════════════════════════════════════════╝
        
        {
            "label": "🔧 Legacy: Make Configure",
            "type": "shell",
            "command": "make",
            "args": ["conf"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": [],
            "detail": "Configure using legacy Make system"
        },
        {
            "label": "🔨 Legacy: Make All",
            "type": "shell",
            "command": "make",
            "args": ["all", "-j8"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": ["$gcc"],
            "detail": "Build using legacy Make system"
        }
    ],
    
    // ╔══════════════════════════════════════════════════════════════════╗
    // ║                    INPUT VARIABLES                                ║
    // ╚══════════════════════════════════════════════════════════════════╝
    
    "inputs": [
        {
            "id": "cmakePreset",
            "type": "pickString",
            "description": "Select CMake preset",
            "options": [
                "default",
                "macos-arm64",
                "macos-x64",
                "linux",
                "debug",
                "release",
                "dev",
                "dev-sanitizers",
                "minimal",
                "ci"
            ],
            "default": "macos-arm64"
        },
        {
            "id": "componentName",
            "type": "pickString",
            "description": "Select component",
            "options": [
                "selforg",
                "ode_robots",
                "ga_tools",
                "guilogger",
                "matrixviz",
                "configurator"
            ],
            "default": "selforg"
        },
        {
            "id": "simulationName",
            "type": "promptString",
            "description": "Enter simulation name",
            "default": "template_sphererobot"
        },
        {
            "id": "templateName",
            "type": "pickString",
            "description": "Select template",
            "options": [
                "template_sphererobot",
                "template_hexapod",
                "template_fourwheeled",
                "template_nimm2",
                "template_nimm4"
            ],
            "default": "template_sphererobot"
        },
        {
            "id": "newSimulationName",
            "type": "promptString",
            "description": "Enter new simulation name",
            "default": "my_simulation"
        }
    ]
}