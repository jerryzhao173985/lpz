{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Homebrew Clangd",
            "type": "shell",
            "command": "/opt/homebrew/opt/llvm/bin/clangd",
            "args": [
                "--background-index",
                "--compile-commands-dir=${workspaceFolder}/build/macos-arm64",
                "--header-insertion=never",
                "--clang-tidy",
                "--malloc-trim",
                "--pch-storage=memory",
                "-j=12",
                "--limit-results=100"
            ],
            "isBackground": true,
            "problemMatcher": [
                {
                    "owner": "clangd-startup",
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": ".",
                        "endsPattern": "."
                    }
                }
            ],
            "presentation": {
                "reveal": "never",
                "panel": "dedicated"
            }
        },
        {
            "label": "Kill All Clangd",
            "type": "shell",
            "command": "pkill",
            "args": ["-f", "/opt/homebrew/opt/llvm/bin/clangd"],
            "problemMatcher": []
        }
    ]
}
