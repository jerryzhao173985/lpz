{
    // ╔══════════════════════════════════════════════════════════════════╗
    // ║  LPZRobots VSCode Settings - Clangd Optimized for M4 Max        ║
    // ║  High-performance configuration for 2,801 C++ files              ║
    // ╚══════════════════════════════════════════════════════════════════╝

    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    // 🏗️ BUILD SYSTEM CONFIGURATION (Unchanged)
    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    // CMake Configuration
    "cmake.configureOnOpen": true,
    "cmake.sourceDirectory": "${workspaceFolder}",
    "cmake.buildDirectory": "${workspaceFolder}/build/${buildPresetName}",
    "cmake.installPrefix": "${workspaceFolder}/install/${buildPresetName}",

    // Force use of CMake presets for consistent builds
    "cmake.useCMakePresets": "always",
    "cmake.defaultConfigure.configurePreset": "macos-arm64",
    "cmake.defaultBuild.buildPreset": "macos-arm64",
    "cmake.defaultTest.testPreset": "macos-arm64",

    // Preferred generators
    "cmake.preferredGenerators": [
        "Ninja",
        "Unix Makefiles"
    ],

    // CMake Configure Settings (fallback if presets fail)
    "cmake.configureSettings": {
        "CMAKE_BUILD_TYPE": "${buildType:Debug}",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "LPZROBOTS_INSTALL_TYPE": "DEVEL",
        "BUILD_SHARED_LIBS": "${config:lpzrobots.sharedLibs:OFF}",
        "BUILD_EXAMPLES": "ON",
        "BUILD_GUI_TOOLS": "ON",
        "BUILD_TESTS": "ON",
        "LPZROBOTS_USE_DOCTEST": "ON",
        "ENABLE_OPENMP": "${config:lpzrobots.openmp:OFF}",
        "ENABLE_SIMD": "${config:lpzrobots.simd:ON}",
        "CMAKE_PREFIX_PATH": "${env:HOMEBREW_PREFIX:/opt/homebrew}",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
    },

    // CMake Tools Extension
    "cmake.parallelJobs": 0,  // Use all available cores
    "cmake.saveBeforeBuild": true,
    "cmake.clearOutputBeforeBuild": false,
    "cmake.copyCompileCommands": "${workspaceFolder}/compile_commands.json",
    "cmake.buildTask": true,
    "cmake.outputLogLevel": "info",

    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    // 🧠 CLANGD LANGUAGE SERVER (Replacing Microsoft C++ IntelliSense)
    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    // Disable Microsoft C++ IntelliSense completely
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.autocomplete": "disabled",
    "C_Cpp.errorSquiggles": "disabled",
    "C_Cpp.formatting": "disabled",
    "C_Cpp.suggestSnippets": false,
    
    // Enable clangd
    "clangd.enabled": true,
    
    // Clangd executable path
    "clangd.path": "/opt/homebrew/opt/llvm/bin/clangd",
    
    // Clangd arguments optimized for M4 Max with 64GB RAM
    "clangd.arguments": [
        // Core functionality
        "--background-index",                    // Index project in background
        "--clang-tidy",                         // Enable clang-tidy checks
        "--completion-style=detailed",           // Detailed completion info
        "--header-insertion=iwyu",              // Include-what-you-use style
        "--pch-storage=memory",                 // Store PCH in memory (fast with 64GB)
        "--function-arg-placeholders",          // Show function parameter hints
        
        // M4 Max performance tuning
        "-j=12",                                // Use all 12 performance cores
        "--malloc-trim",                        // Trim memory periodically
        "--background-index-priority=normal",   // Normal priority - M4 can handle it
        
        // Code analysis
        "--enable-config",                      // Use .clangd config file
        "--clang-tidy-checks=*",               // Enable all clang-tidy checks
        "--header-insertion-decorators",        // Show where headers will be inserted
        "--all-scopes-completion",              // Complete from all visible scopes
        "--limit-results=0",                    // No limit with 64GB RAM
        "--limit-references=0",                 // No limit on references
        
        // Logging and debugging
        "--log=info",                           // Log level
        "--pretty",                             // Pretty-print JSON output
        
        // LPZRobots specific
        "--compile-commands-dir=${workspaceFolder}/build/macos-arm64",
        "--query-driver=/usr/bin/clang++,/opt/homebrew/opt/llvm/bin/clang++",
        
        // Memory optimization for 64GB system
        "--preamble-storage=memory",            // Store all preambles in memory
        "--index-file-size-limit=0",            // No file size limit for indexing
        
        // ARM64 optimizations
        "--target=arm64-apple-darwin"
    ],
    
    // Clangd specific settings
    "clangd.serverCompletionRanking": true,     // Use server-side completion ranking
    "clangd.detectExtensionConflicts": true,    // Warn about conflicting extensions
    "clangd.restartAfterCrash": true,           // Auto-restart on crash
    "clangd.semanticHighlighting": true,        // Better syntax highlighting
    
    // Inlay hints configuration
    "clangd.inlayHints.enable": true,
    "clangd.inlayHints.parameterNames.enabled": true,
    "clangd.inlayHints.parameterNames.suppressWhenArgumentMatchesName": true,
    "clangd.inlayHints.functionReturnType.enabled": false,
    "clangd.inlayHints.chainingHints.enabled": true,
    "clangd.inlayHints.typeHints.enabled": false,
    "clangd.inlayHints.auto.enabled": true,
    "clangd.inlayHints.designators.enabled": true,
    "clangd.inlayHints.blockEnd.enabled": true,
    
    // Completion settings
    "clangd.completion.enableSnippets": true,
    "clangd.completion.placeholder": true,
    "clangd.completion.detailedLabel": true,
    "clangd.completion.postfix": true,
    
    // Diagnostics
    "clangd.diagnostics.enable": true,
    "clangd.diagnostics.suppressFromNonProjectFiles": true,

    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    // 🔧 LPZROBOTS-SPECIFIC SETTINGS (Unchanged)
    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    // LPZRobots Configuration
    "lpzrobots.version": "0.1.0",
    "lpzrobots.sharedLibs": false,
    "lpzrobots.openmp": false,
    "lpzrobots.simd": true,
    "lpzrobots.platformDefines": [
        "MAC",
        "MAC_ARM64",
        "__ARM_NEON"
    ],
    
    // Component-specific settings
    "lpzrobots.components": {
        "selforg": {
            "buildTests": true,
            "enableOptimizations": true,
            "enableGSL": true
        },
        "ode_robots": {
            "defaultSimulation": "template_sphererobot",
            "enableGraphics": true,
            "shadowTextures": false
        },
        "ga_tools": {
            "enableParallelGA": false
        },
        "guilogger": {
            "defaultChannels": 5,
            "windowSize": "800x600"
        }
    },

    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    // 📂 FILE MANAGEMENT (Enhanced for clangd)
    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    // File associations for clangd
    "files.associations": {
        "*.h": "cpp",
        "*.hpp": "cpp",
        "*.cpp": "cpp",
        "*.cc": "cpp",
        "*.cxx": "cpp",
        "*.c++": "cpp",
        "*.tcc": "cpp",
        "*.ipp": "cpp",
        // LPZRobots headers without extensions
        "matrix": "cpp",
        "configurable": "cpp",
        "abstractcontroller": "cpp",
        "oderobot": "cpp",
        "primitive": "cpp",
        "joint": "cpp",
        "sensor": "cpp",
        "motor": "cpp",
        // Standard library headers
        "algorithm": "cpp",
        "array": "cpp",
        "atomic": "cpp",
        "chrono": "cpp",
        "cmath": "cpp",
        "complex": "cpp",
        "condition_variable": "cpp",
        "deque": "cpp",
        "exception": "cpp",
        "functional": "cpp",
        "iterator": "cpp",
        "memory": "cpp",
        "memory_resource": "cpp",
        "numeric": "cpp",
        "optional": "cpp",
        "random": "cpp",
        "ratio": "cpp",
        "regex": "cpp",
        "set": "cpp",
        "string": "cpp",
        "string_view": "cpp",
        "system_error": "cpp",
        "tuple": "cpp",
        "type_traits": "cpp",
        "unordered_map": "cpp",
        "unordered_set": "cpp",
        "utility": "cpp",
        "vector": "cpp"
    },

    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    // ✏️ EDITOR SETTINGS (Optimized for clangd)
    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    
    // General editor settings
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "modificationsIfAvailable",
    "editor.rulers": [100],
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.trimAutoWhitespace": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    "editor.stickyScroll.enabled": true,
    "editor.minimap.renderCharacters": false,
    "editor.minimap.maxColumn": 100,
    
    // Language-specific settings for clangd
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.suggest.insertMode": "replace",
        "editor.wordBasedSuggestions": "off",
        "editor.formatOnSave": true,
        "editor.semanticHighlighting.enabled": true
    },
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": true,
        "editor.semanticHighlighting.enabled": true
    },

    // IntelliSense behavior
    "editor.quickSuggestions": {
        "other": true,
        "comments": false,
        "strings": true
    },
    "editor.suggestSelection": "first",
    "editor.snippetSuggestions": "top",
    "editor.suggest.localityBonus": true,
    "editor.suggest.snippetsPreventQuickSuggestions": false,

    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    // 🖥️ TERMINAL & ENVIRONMENT (Enhanced for clangd)
    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    
    // macOS Terminal Environment
    "terminal.integrated.env.osx": {
        "PATH": "/opt/homebrew/opt/llvm/bin:${env:PATH}",
        "DYLD_LIBRARY_PATH": "${workspaceFolder}/lib:${workspaceFolder}/build/${config:cmake.buildDirectory}/lib",
        "DYLD_FALLBACK_LIBRARY_PATH": "${env:HOMEBREW_PREFIX:/opt/homebrew}/lib",
        "LPZROBOTS_ROOT": "${workspaceFolder}",
        "LPZROBOTS_DEBUG_EVENTS": "${config:lpzrobots.debugEvents:0}",
        "CMAKE_PREFIX_PATH": "${env:HOMEBREW_PREFIX:/opt/homebrew}/opt/qt@6:${env:HOMEBREW_PREFIX:/opt/homebrew}",
        "HOMEBREW_PREFIX": "${env:HOMEBREW_PREFIX:/opt/homebrew}",
        "CLANGD_FLAGS": "--compile-commands-dir=${workspaceFolder}/build/macos-arm64"
    },

    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    // 🔨 MAKEFILE TOOLS CONFIGURATION
    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    
    // Strategy: Since we use CMake as primary build system, disable Makefile Tools
    // to prevent timeout errors from the complex legacy Make system.
    // Use CMake Tools (already configured above) for IntelliSense and building.
    
    // Completely disable Makefile Tools for this workspace
    "makefile.configureOnOpen": false,
    "makefile.configureOnEdit": false,
    "makefile.configureAfterCommand": false,
    
    // If you need to use legacy Make, run these commands manually:
    // 1. make conf     (first time setup)
    // 2. make all      (build everything)
    // 3. Use CMake for development (faster, better IDE integration)
    
    // Keep all other settings from original configuration...
    // (debugging, testing, search exclusions, etc.)
}