{
    // LPZRobots VSCode Settings - Simple and Working Configuration
    // Optimized for macOS ARM64 (M4 Max) with standard Microsoft C++ IntelliSense

    // CMake Configuration
    "cmake.configureOnOpen": true,
    "cmake.sourceDirectory": "${workspaceFolder}",
    "cmake.buildDirectory": "${workspaceFolder}/build/${buildPresetName}",
    "cmake.installPrefix": "${workspaceFolder}/install/${buildPresetName}",
    "cmake.parallelJobs": 0,  // Use all available cores
    "cmake.saveBeforeBuild": true,
    "cmake.outputLogLevel": "info",

    // CMake Configure Settings
    "cmake.configureSettings": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
    },

    // C++ IntelliSense Configuration
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "C_Cpp.default.compilerPath": "/usr/bin/clang++",
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.intelliSenseMode": "macos-clang-arm64",
    "C_Cpp.clang_format_path": "/opt/homebrew/bin/clang-format",
    "C_Cpp.formatting": "clangFormat",
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.autocomplete": "default",
    "C_Cpp.errorSquiggles": "enabled",

    // File associations
    "files.associations": {
        "*.h": "cpp",
        "*.hpp": "cpp",
        "*.cpp": "cpp",
        "*.cc": "cpp",
        "*.cxx": "cpp",
        "*.tcc": "cpp",
        "*.ipp": "cpp",
        // LPZRobots headers without extensions
        "matrix": "cpp",
        "configurable": "cpp",
        "abstractcontroller": "cpp",
        "oderobot": "cpp",
        "primitive": "cpp",
        "joint": "cpp",
        "sensor": "cpp",
        "motor": "cpp",
        // Standard library headers
        "algorithm": "cpp",
        "array": "cpp",
        "atomic": "cpp",
        "chrono": "cpp",
        "cmath": "cpp",
        "complex": "cpp",
        "deque": "cpp",
        "functional": "cpp",
        "memory": "cpp",
        "optional": "cpp",
        "vector": "cpp",
        "string": "cpp",
        "unordered_map": "cpp"
    },

    // Editor settings
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "modificationsIfAvailable",
    "editor.rulers": [100],
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.trimAutoWhitespace": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.suggest.insertMode": "replace",
        "editor.wordBasedSuggestions": "off",
        "editor.formatOnSave": true
    },

    // Terminal environment
    "terminal.integrated.env.osx": {
        "DYLD_LIBRARY_PATH": "${workspaceFolder}/lib:${workspaceFolder}/build/lib",
        "LPZROBOTS_ROOT": "${workspaceFolder}",
        "CMAKE_PREFIX_PATH": "/opt/homebrew"
    },

    // Disable Makefile Tools (use CMake instead)
    "makefile.configureOnOpen": false,
    "makefile.configureOnEdit": false,
    "makefile.configureAfterCommand": false,

    // File exclusions
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/build": true,
        "**/*.o": true,
        "**/*.a": true,
        "**/*.so": true,
        "**/*.dylib": true
    },

    // Search exclusions
    "search.exclude": {
        "**/build": true,
        "**/node_modules": true,
        "**/*.code-search": true,
        "**/.vscode/browse.vc.db*": true,
        "**/opende/drawstuff/src/osx_carbon": true
    }
}