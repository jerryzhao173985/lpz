// LPZRobots Custom Keyboard Shortcuts
[
    // Build shortcuts
    {
        "key": "cmd+shift+b",
        "command": "cmake.build",
        "when": "!inDebugMode"
    },
    {
        "key": "cmd+shift+alt+b",
        "command": "cmake.cleanRebuild"
    },
    
    // Debug shortcuts
    {
        "key": "f5",
        "command": "cmake.debugTarget",
        "when": "!inDebugMode && cmake.buildKit && cmake.status != 'building' && cmake.status != 'configuring'"
    },
    
    // Navigation
    {
        "key": "cmd+alt+o",
        "command": "C_Cpp.SwitchHeaderSource",
        "when": "editorTextFocus && resourceExtname =~ /\\.(cpp|c|cc|cxx|hpp|h)$/"
    },
    
    // Quick actions
    {
        "key": "cmd+.",
        "command": "editor.action.quickFix",
        "when": "editorTextFocus"
    }
]