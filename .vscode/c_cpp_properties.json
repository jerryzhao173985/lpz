        },
        {
            "name": "Component: ode_robots",
            "compileCommands": "${workspaceFolder}/build/${config:cmake.buildDirectory}/compile_commands.json",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "${default}",
            "defines": [
                "${config:lpzrobots.platformDefines}",
                "ODE_ROBOTS_COMPONENT"
            ],
            "includePath": [
                "${workspaceFolder}/ode_robots/include/**",
                "${workspaceFolder}/selforg/include/**",
                "${workspaceFolder}/opende/include/**",
                "${workspaceFolder}/include/**",
                "${workspaceFolder}/build/include/**",
                "/opt/homebrew/include",
                "/opt/homebrew/opt/openscenegraph/include"
            ],
            "compilerPath": "${default}"
        },
        {
            "name": "Simulation Development",
            "compileCommands": "${workspaceFolder}/build/${config:cmake.buildDirectory}/compile_commands.json",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "${default}",
            "defines": [
                "${config:lpzrobots.platformDefines}",
                "SIMULATION_MODE"
            ],
            "includePath": [
                "${workspaceFolder}/include/**",
                "${workspaceFolder}/ode_robots/simulations/${fileBasenameNoExtension}/**",
                "/opt/homebrew/include",
                "/opt/homebrew/opt/openscenegraph/include",
                "/opt/homebrew/opt/qt@6/include"
            ],
            "compilerPath": "${default}"
        }
    ],
    "version": 4,
    "enableConfigurationSquiggles": true
}