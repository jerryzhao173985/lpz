{
    "configurations": [
        {
            "name": "Mac",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/selforg",
                "${workspaceFolder}/selforg/include",
                "${workspaceFolder}/ode_robots",
                "${workspaceFolder}/ode_robots/include", 
                "${workspaceFolder}/ga_tools",
                "${workspaceFolder}/ga_tools/include",
                "${workspaceFolder}/include",
                "${workspaceFolder}/include/ode-dbl",
                "/opt/homebrew/include",
                "/opt/homebrew/opt/qt@6/include",
                "/opt/homebrew/opt/open-scene-graph/include",
                "/opt/homebrew/opt/gsl/include"
            ],
            "defines": [
                "MAC",
                "MAC_ARM64",
                "_DEBUG",
                "UNICODE",
                "_UNICODE"
            ],
            "macFrameworkPath": [
                "/System/Library/Frameworks",
                "/Library/Frameworks"
            ],
            "compilerPath": "/usr/bin/clang++",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "macos-clang-arm64",
            "configurationProvider": "ms-vscode.cmake-tools",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json"
        },
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/selforg",
                "${workspaceFolder}/selforg/include",
                "${workspaceFolder}/ode_robots",
                "${workspaceFolder}/ode_robots/include",
                "${workspaceFolder}/ga_tools", 
                "${workspaceFolder}/ga_tools/include",
                "${workspaceFolder}/include",
                "${workspaceFolder}/include/ode-dbl",
                "/usr/include",
                "/usr/local/include"
            ],
            "defines": [
                "LINUX",
                "_DEBUG",
                "UNICODE",
                "_UNICODE"
            ],
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x64",
            "configurationProvider": "ms-vscode.cmake-tools",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json"
        }
    ],
    "version": 4
}