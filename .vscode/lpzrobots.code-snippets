    "LPZ SIMD Function": {
        "prefix": "lpzsimd",
        "body": [
            "#ifdef __ARM_NEON",
            "#include <arm_neon.h>",
            "",
            "void ${1:operation}_neon(const double* a, const double* b, double* result, size_t n) {",
            "    size_t simd_end = n - (n % 2);",
            "    ",
            "    for (size_t i = 0; i < simd_end; i += 2) {",
            "        float64x2_t va = vld1q_f64(&a[i]);",
            "        float64x2_t vb = vld1q_f64(&b[i]);",
            "        float64x2_t vr = ${2:vaddq_f64}(va, vb);",
            "        vst1q_f64(&result[i], vr);",
            "    }",
            "    ",
            "    // Handle remaining elements",
            "    for (size_t i = simd_end; i < n; ++i) {",
            "        result[i] = ${3:a[i] + b[i]};",
            "    }",
            "}",
            "#elif defined(__AVX__)",
            "#include <immintrin.h>",
            "",
            "void ${1:operation}_avx(const double* a, const double* b, double* result, size_t n) {",
            "    size_t simd_end = n - (n % 4);",
            "    ",
            "    for (size_t i = 0; i < simd_end; i += 4) {",
            "        __m256d va = _mm256_loadu_pd(&a[i]);",
            "        __m256d vb = _mm256_loadu_pd(&b[i]);",
            "        __m256d vr = ${4:_mm256_add_pd}(va, vb);",
            "        _mm256_storeu_pd(&result[i], vr);",
            "    }",
            "    ",
            "    // Handle remaining elements",
            "    for (size_t i = simd_end; i < n; ++i) {",
            "        result[i] = ${3:a[i] + b[i]};",
            "    }",
            "}",
            "#endif"
        ],
        "description": "SIMD optimized function template"
    },
    
