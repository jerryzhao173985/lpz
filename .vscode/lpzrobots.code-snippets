    // ==================== LEARNING PATTERNS ====================
    
    "LPZ Homeokinetic Learning": {
        "prefix": "lpzhomeokinlearn",
        "body": [
            "// Homeokinetic learning step",
            "void learn() {",
            "    const Matrix& x = x_buffer.get(0);",
            "    const Matrix& x_tm1 = x_buffer.get(-1);",
            "    const Matrix& y_tm1 = y_buffer.get(-1);",
            "    ",
            "    // Prediction error",
            "    Matrix xi = x - (C * y_tm1 + h);",
            "    ",
            "    // Learning signal",
            "    Matrix eta = A.pseudoInverse() * xi;",
            "    ",
            "    // Jacobian",
            "    Matrix g_prime = Matrix::map2(g_s, C * y_tm1 + A * x_tm1 + h, eta);",
            "    L = C * g_prime;",
            "    ",
            "    // Update model",
            "    A += (xi * (eta * g_prime).mapP(0.0, clip)).multMT() * eps;",
            "    h += xi * eps * 0.2;",
            "    ",
            "    // Update controller (homeokinetic)",
            "    Matrix v = (L.multTM() + Matrix::eye(motornumber) * regularization).inverse() * L.multTM();",
            "    C += (v * xi * (y_tm1 * g_prime).mapP(0.0, clip)).multMT() * eps * creativity;",
            "}"
        ],
        "description": "Homeokinetic learning algorithm implementation"
    },
    
