    "LPZ Controller with Learning Strategy": {
        "prefix": "lpzstrategycont",
        "body": [
            "#pragma once",
            "",
            "#include <selforg/controller/controllerbase.h>",
            "#include <selforg/controller/learning_strategy.h>",
            "#include <selforg/controller/management_strategy.h>",
            "#include <memory>",
            "",
            "namespace lpzrobots {",
            "",
            "class ${1:StrategyController} : public ControllerBase {",
            "public:",
            "    ${1:StrategyController}(const std::string& name = \"${1:StrategyController}\")",
            "        : ControllerBase(name, \"$Id$\") {",
            "        // Set up strategies",
            "        learning_strategy_ = std::make_unique<HomeokineticsLearning>();",
            "        management_strategy_ = std::make_unique<DampingManagement>(0.00001);",
            "        ",
            "        addParameterDef(\"strategy\", &strategy_type, 0, 0, 2, ",
            "                        \"learning strategy (0=homeokinetic, 1=teachable, 2=random)\");",
            "    }",
            "",
            "    void init(int sensornumber, int motornumber, RandGen* randGen = nullptr) override {",
            "        ControllerBase::init(sensornumber, motornumber, randGen);",
            "        learning_strategy_->init(this);",
            "        management_strategy_->init(this);",
            "    }",
            "",
            "    void step(const sensor* sensors, int sensornumber,",
            "              motor* motors, int motornumber) override {",
            "        // Forward step",
            "        Matrix x(sensornumber, 1, sensors);",
            "        Matrix y = (C * y_buffer.back() + A * x + h).map(g);",
            "        y.convertToBuffer(motors, motornumber);",
            "        ",
            "        // Store for learning",
            "        x_buffer.push_back(x);",
            "        y_buffer.push_back(y);",
            "        ",
            "        // Apply strategies",
            "        if (t > buffersize) {",
            "            learning_strategy_->learn(*this, x_buffer, y_buffer, A, C, h);",
            "            management_strategy_->manage(*this, A, C, h);",
            "        }",
            "        t++;",
            "    }",
            "",
            "    void switchStrategy(int type) {",
            "        switch(type) {",
            "            case 0:",
            "                learning_strategy_ = std::make_unique<HomeokineticsLearning>();",
            "                break;",
            "            case 1:",
            "                learning_strategy_ = std::make_unique<TeachableHomeokineticsLearning>();",
            "                break;",
            "            case 2:",
            "                learning_strategy_ = std::make_unique<RandomLearning>();",
            "                break;",
            "        }",
            "        learning_strategy_->init(this);",
            "    }",
            "",
            "private:",
            "    std::unique_ptr<LearningStrategy> learning_strategy_;",
            "    std::unique_ptr<ManagementStrategy> management_strategy_;",
            "    int strategy_type = 0;",
            "};",
            "",
            "} // namespace lpzrobots"
        ],
        "description": "Controller with pluggable learning and management strategies"
    },
    
