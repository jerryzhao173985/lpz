{
    // ╔══════════════════════════════════════════════════════════════════╗
    // ║           LPZRobots Command Palette Commands                      ║
    // ╚══════════════════════════════════════════════════════════════════╝
    //
    // These commands appear in the Command Palette (Cmd+Shift+P)
    // They provide quick access to common LPZRobots development tasks
    
    "lpzrobots.commands": [
        // ═══════════════════════════════════════════════════════════════════
        // Build Commands
        // ═══════════════════════════════════════════════════════════════════
        
        {
            "command": "lpzrobots.build.all",
            "title": "LPZ: Build All Components",
            "category": "LPZRobots",
            "icon": "$(tools)"
        },
        {
            "command": "lpzrobots.build.current",
            "title": "LPZ: Build Current Component",
            "category": "LPZRobots",
            "icon": "$(symbol-method)"
        },
        {
            "command": "lpzrobots.build.clean",
            "title": "LPZ: Clean Build",
            "category": "LPZRobots",
            "icon": "$(trash)"
        },
        
        // ═══════════════════════════════════════════════════════════════════
        // Simulation Commands
        // ═══════════════════════════════════════════════════════════════════
        
        {
            "command": "lpzrobots.simulation.run",
            "title": "LPZ: Run Simulation",
            "category": "LPZRobots",
            "icon": "$(play)"
        },
        {
            "command": "lpzrobots.simulation.runWithGui",
            "title": "LPZ: Run Simulation with GUI",
            "category": "LPZRobots",
            "icon": "$(eye)"
        },
        {
            "command": "lpzrobots.simulation.debug",
            "title": "LPZ: Debug Simulation",
            "category": "LPZRobots",
            "icon": "$(debug)"
        },
        {
            "command": "lpzrobots.simulation.create",
            "title": "LPZ: Create New Simulation",
            "category": "LPZRobots",
            "icon": "$(add)"
        },
        
        // ═══════════════════════════════════════════════════════════════════
        // Testing Commands
        // ═══════════════════════════════════════════════════════════════════
        
        {
            "command": "lpzrobots.test.all",
            "title": "LPZ: Run All Tests",
            "category": "LPZRobots",
            "icon": "$(beaker)"
        },
        {
            "command": "lpzrobots.test.current",
            "title": "LPZ: Test Current Component",
            "category": "LPZRobots",
            "icon": "$(test-view-icon)"
        },
        {
            "command": "lpzrobots.test.withSanitizers",
            "title": "LPZ: Run Tests with Sanitizers",
            "category": "LPZRobots",
            "icon": "$(shield)"
        },
        
        // ═══════════════════════════════════════════════════════════════════
        // Code Quality Commands
        // ═══════════════════════════════════════════════════════════════════
        
        {
            "command": "lpzrobots.format.file",
            "title": "LPZ: Format Current File",
            "category": "LPZRobots",
            "icon": "$(code)"
        },
        {
            "command": "lpzrobots.format.all",
            "title": "LPZ: Format All Files",
            "category": "LPZRobots",
            "icon": "$(file-code)"
        },
        {
            "command": "lpzrobots.analyze.clangTidy",
            "title": "LPZ: Run Clang-Tidy Analysis",
            "category": "LPZRobots",
            "icon": "$(search)"
        },
        {
            "command": "lpzrobots.analyze.cppcheck",
            "title": "LPZ: Run Cppcheck Analysis",
            "category": "LPZRobots",
            "icon": "$(warning)"
        },
        
        // ═══════════════════════════════════════════════════════════════════
        // Component Commands
        // ═══════════════════════════════════════════════════════════════════
        
        {
            "command": "lpzrobots.component.createController",
            "title": "LPZ: Create New Controller",
            "category": "LPZRobots",
            "icon": "$(circuit-board)"
        },
        {
            "command": "lpzrobots.component.createRobot",
            "title": "LPZ: Create New Robot",
            "category": "LPZRobots",
            "icon": "$(vm)"
        },
        {
            "command": "lpzrobots.component.registerFactory",
            "title": "LPZ: Register in Factory",
            "category": "LPZRobots",
            "icon": "$(layers)"
        },
        
        // ═══════════════════════════════════════════════════════════════════
        // Workflow Commands
        // ═══════════════════════════════════════════════════════════════════
        
        {
            "command": "lpzrobots.workflow.cleanBuild",
            "title": "LPZ: Workflow - Clean Build",
            "category": "LPZRobots",
            "icon": "$(rocket)"
        },
        {
            "command": "lpzrobots.workflow.buildAndTest",
            "title": "LPZ: Workflow - Build and Test",
            "category": "LPZRobots",
            "icon": "$(check-all)"
        },
        {
            "command": "lpzrobots.workflow.simulationDev",
            "title": "LPZ: Workflow - Simulation Development",
            "category": "LPZRobots",
            "icon": "$(device-desktop)"
        },
        {
            "command": "lpzrobots.workflow.formatAndAnalyze",
            "title": "LPZ: Workflow - Format and Analyze",
            "category": "LPZRobots",
            "icon": "$(sparkle)"
        },
        
        // ═══════════════════════════════════════════════════════════════════
        // Documentation Commands
        // ═══════════════════════════════════════════════════════════════════
        
        {
            "command": "lpzrobots.docs.generate",
            "title": "LPZ: Generate Documentation",
            "category": "LPZRobots",
            "icon": "$(book)"
        },
        {
            "command": "lpzrobots.docs.viewApi",
            "title": "LPZ: View API Documentation",
            "category": "LPZRobots",
            "icon": "$(globe)"
        },
        {
            "command": "lpzrobots.docs.addDoxygen",
            "title": "LPZ: Add Doxygen Comments",
            "category": "LPZRobots",
            "icon": "$(comment)"
        },
        
        // ═══════════════════════════════════════════════════════════════════
        // Utility Commands
        // ═══════════════════════════════════════════════════════════════════
        
        {
            "command": "lpzrobots.util.switchToClangd",
            "title": "LPZ: Switch to Clangd",
            "category": "LPZRobots",
            "icon": "$(extensions)"
        },
        {
            "command": "lpzrobots.util.openWorkspace",
            "title": "LPZ: Open LPZRobots Workspace",
            "category": "LPZRobots",
            "icon": "$(folder)"
        },
        {
            "command": "lpzrobots.util.refreshIntelliSense",
            "title": "LPZ: Refresh IntelliSense",
            "category": "LPZRobots",
            "icon": "$(refresh)"
        },
        {
            "command": "lpzrobots.util.showBuildOutput",
            "title": "LPZ: Show Build Output",
            "category": "LPZRobots",
            "icon": "$(output)"
        }
    ],
    
    // ═══════════════════════════════════════════════════════════════════
    // Command Implementation Mapping
    // ═══════════════════════════════════════════════════════════════════
    
    "lpzrobots.commandMap": {
        "lpzrobots.build.all": "workbench.action.tasks.runTask",
        "lpzrobots.build.current": "workbench.action.tasks.runTask",
        "lpzrobots.simulation.run": "workbench.action.tasks.runTask",
        "lpzrobots.simulation.debug": "workbench.action.debug.start",
        "lpzrobots.test.all": "workbench.action.tasks.runTask",
        "lpzrobots.format.file": "editor.action.formatDocument",
        "lpzrobots.analyze.clangTidy": "workbench.action.tasks.runTask"
    }
}