#!/usr/bin/env python3
"""
lpz-debug - Debugging tool for LPZRobots simulations

Common debugging tasks for robot simulations:
- Check for NaN/Inf in controller matrices
- Monitor controller stability
- Analyze convergence
- Debug sensor/motor issues
"""

import sys
import os
import argparse
import numpy as np
import subprocess
import signal
import time
from pathlib import Path

class LPZDebugger:
    def __init__(self):
        self.process = None
        
    def check_stability(self, logfile):
        """Check controller stability from log file"""
        print(f"Analyzing stability from {logfile}...")
        
        try:
            data = np.loadtxt(logfile, skiprows=1)
            if data.size == 0:
                print("Error: Empty log file")
                return
                
            # Extract motor values (assuming standard format)
            # Format: time, sensors..., motors..., x-values...
            n_cols = data.shape[1]
            
            # Detect where motors start (heuristic)
            # Usually sensors and motors are balanced
            n_sensors_motors = (n_cols - 1) // 3  # Rough estimate
            motor_start = 1 + n_sensors_motors // 2
            motor_end = 1 + n_sensors_motors
            
            motors = data[:, motor_start:motor_end]
            
            # Check for NaN/Inf
            if np.any(np.isnan(motors)):
                print("❌ WARNING: NaN values detected in motor outputs!")
                nan_times = np.where(np.any(np.isnan(motors), axis=1))[0]
                print(f"   First NaN at timestep {nan_times[0]}")
                
            if np.any(np.isinf(motors)):
                print("❌ WARNING: Infinite values detected in motor outputs!")
                inf_times = np.where(np.any(np.isinf(motors), axis=1))[0]
                print(f"   First Inf at timestep {inf_times[0]}")
                
            # Check for oscillations
            if motors.shape[0] > 100:
                motor_std = np.std(motors[-100:], axis=0)
                motor_mean = np.mean(np.abs(motors[-100:]), axis=0)
                
                oscillation_index = motor_std / (motor_mean + 1e-10)
                
                if np.any(oscillation_index > 0.5):
                    print("⚠️  High oscillations detected in motors:", 
                          np.where(oscillation_index > 0.5)[0])
                else:
                    print("✅ Motor outputs appear stable")
                    
            # Check for saturation
            motor_max = np.max(np.abs(motors))
            if motor_max > 0.95:
                print(f"⚠️  Motors near saturation (max: {motor_max:.3f})")
            
            # Check convergence
            if motors.shape[0] > 1000:
                early = np.mean(motors[100:200])
                late = np.mean(motors[-100:])
                if abs(early - late) < 0.01:
                    print("✅ Controller appears to have converged")
                else:
                    print(f"⚠️  Controller still changing (drift: {abs(early-late):.3f})")
                    
        except Exception as e:
            print(f"Error analyzing log file: {e}")
            
    def monitor_live(self, command):
        """Monitor simulation in real-time for issues"""
        print("Starting live monitoring...")
        print("Press Ctrl+C to stop")
        
        # Start the simulation
        env = os.environ.copy()
        env['LPZROBOTS_DEBUG'] = '1'
        
        try:
            self.process = subprocess.Popen(
                command,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                universal_newlines=True,
                bufsize=1,
                env=env
            )
            
            # Monitor output
            error_count = 0
            warning_count = 0
            
            while True:
                line = self.process.stderr.readline()
                if not line and self.process.poll() is not None:
                    break
                    
                if line:
                    # Check for common issues
                    if "nan" in line.lower() or "inf" in line.lower():
                        print(f"❌ NUMERICAL ERROR: {line.strip()}")
                        error_count += 1
                        
                    elif "warning" in line.lower():
                        print(f"⚠️  WARNING: {line.strip()}")
                        warning_count += 1
                        
                    elif "assert" in line.lower() or "abort" in line.lower():
                        print(f"❌ CRASH: {line.strip()}")
                        error_count += 1
                        
                    elif "converge" in line.lower():
                        print(f"ℹ️  {line.strip()}")
                        
            print(f"\nMonitoring complete. Errors: {error_count}, Warnings: {warning_count}")
            
        except KeyboardInterrupt:
            print("\nStopping monitor...")
            if self.process:
                self.process.terminate()
                
    def check_matrix_health(self, ctrlfile):
        """Check controller matrix file for issues"""
        print(f"Checking controller matrices in {ctrlfile}...")
        
        try:
            with open(ctrlfile, 'r') as f:
                content = f.read()
                
            # Parse matrix entries
            import re
            numbers = re.findall(r'[-+]?\d*\.?\d+(?:[eE][-+]?\d+)?', content)
            values = [float(n) for n in numbers]
            
            if not values:
                print("No numeric values found")
                return
                
            values_array = np.array(values)
            
            # Check for issues
            if np.any(np.isnan(values_array)):
                print("❌ NaN values found in controller matrices!")
                
            if np.any(np.isinf(values_array)):
                print("❌ Infinite values found in controller matrices!")
                
            # Check matrix norms
            max_val = np.max(np.abs(values_array))
            if max_val > 10:
                print(f"⚠️  Large matrix values detected (max: {max_val:.2f})")
                print("   This may indicate instability")
            else:
                print(f"✅ Matrix values in reasonable range (max: {max_val:.2f})")
                
            # Check for near-zero values (dead neurons)
            near_zero = np.sum(np.abs(values_array) < 1e-6)
            if near_zero > len(values_array) * 0.5:
                print(f"⚠️  Many near-zero values ({near_zero}/{len(values_array)})")
                print("   Controller may be inactive")
                
        except Exception as e:
            print(f"Error reading controller file: {e}")
            
    def suggest_fixes(self, issue):
        """Suggest fixes for common issues"""
        fixes = {
            'nan': """
Fixes for NaN/Inf issues:
1. Reduce learning rate: controller->setParam("epsA", 0.01);
2. Add damping: controller->setParam("damping", 0.01);  
3. Check sensor scaling - values should be in [-1, 1]
4. Enable logarithmic error: controller->setParam("Logarithmic", 1);
5. Add matrix normalization in controller step()
""",
            'oscillation': """
Fixes for oscillations:
1. Increase damping: controller->setParam("damping", 0.05);
2. Reduce controller learning rate: controller->setParam("epsC", 0.01);
3. Add noise: new ColorUniformNoise(0.05) in wiring
4. Use smoothing: controller->setParam("s4avg", 5);
""",
            'convergence': """
Fixes for convergence issues:
1. Wait longer - some controllers need 10000+ steps
2. Increase learning rate slightly
3. Check if sensors are providing useful information
4. Try different initialization: controller->setParam("initFeedbackStrength", 1.0);
""",
            'saturation': """
Fixes for motor saturation:
1. Reduce controller gain
2. Add output scaling in wiring
3. Check robot's motor limits
4. Use tanh activation instead of linear
"""
        }
        
        if issue in fixes:
            print(fixes[issue])
        else:
            print(f"No specific fixes for '{issue}'")

def main():
    parser = argparse.ArgumentParser(
        description='Debug LPZRobots simulations',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  lpz-debug --check-stability robot.log
  lpz-debug --monitor ./start -noshadow
  lpz-debug --check-matrix controller.ctrl
  lpz-debug --suggest nan
        """
    )
    
    parser.add_argument('--check-stability', metavar='LOGFILE',
                       help='Analyze stability from log file')
    parser.add_argument('--monitor', nargs='+', metavar='CMD',
                       help='Monitor simulation live')
    parser.add_argument('--check-matrix', metavar='CTRLFILE',
                       help='Check controller matrix file')
    parser.add_argument('--suggest', metavar='ISSUE',
                       choices=['nan', 'oscillation', 'convergence', 'saturation'],
                       help='Suggest fixes for common issues')
    
    args = parser.parse_args()
    
    if len(sys.argv) == 1:
        parser.print_help()
        return
        
    debugger = LPZDebugger()
    
    if args.check_stability:
        debugger.check_stability(args.check_stability)
    elif args.monitor:
        debugger.monitor_live(args.monitor)
    elif args.check_matrix:
        debugger.check_matrix_health(args.check_matrix)
    elif args.suggest:
        debugger.suggest_fixes(args.suggest)

if __name__ == '__main__':
    main()