#!/bin/bash
# LPZRobots Pre-commit Hook for Cppcheck
# Runs quick static analysis on changed files before commit

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Get the directory where this script is located
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CPPCHECK_DIR="$(dirname "$HOOK_DIR")"
ANALYZE_SCRIPT="$CPPCHECK_DIR/scripts/analyze.py"

echo -e "${BLUE}Running pre-commit cppcheck analysis...${NC}"

# Get list of staged C++ files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|cc|cxx|h|hpp)$')

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}No C++ files to check${NC}"
    exit 0
fi

# Convert to absolute paths
ABSOLUTE_FILES=""
for file in $STAGED_FILES; do
    ABSOLUTE_FILES="$ABSOLUTE_FILES $(pwd)/$file"
done

# Run quick analysis on staged files
python3 "$ANALYZE_SCRIPT" \
    --profile quick_check \
    --files $ABSOLUTE_FILES \
    --format text \
    --threshold 0

RESULT=$?

if [ $RESULT -ne 0 ]; then
    echo -e "${RED}Pre-commit check failed!${NC}"
    echo "Fix the errors above or use --no-verify to skip this check"
    exit 1
fi

echo -e "${GREEN}Pre-commit check passed!${NC}"
exit 0