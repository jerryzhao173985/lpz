#!/bin/sh
## File:     ode-dbl-config for ODE compatibility
## Author:   Georg Martius (original M4 version)
## CMake version: Generated from ode-dbl-config.sh.in template
## Date:     @GENERATION_DATE@
## Version:  @PROJECT_VERSION@

# This file is generated by CMake from ode-dbl-config.sh.in
# Do not edit this file directly

prefix="@CMAKE_INSTALL_PREFIX@"
srcprefix="@CMAKE_SOURCE_DIR@"
type="@LPZROBOTS_INSTALL_TYPE@"

# ODE library location (system or custom)
ODE_LIBS="@LPZROBOTS_ODE_LIBRARIES@"

# Base compiler flags
CBASEFLAGS=""

# Add architecture flags on macOS
if [ "@CMAKE_SYSTEM_NAME@" = "Darwin" ]; then
    if [ "@CMAKE_OSX_ARCHITECTURES@" = "arm64" ]; then
        CBASEFLAGS="$CBASEFLAGS -arch arm64"
    fi
fi

usage="\
Usage: ode-dbl-config [--prefix[=DIR]] [--srcprefix[=DIR]] [--cflags] [--libs]"

if test $# -eq 0; then
    echo "${usage}" 1>&2
    exit 1
fi

while test $# -gt 0; do
    case "$1" in
    -*=*) optarg=`echo "$1" | sed 's/[-_a-zA-Z0-9]*=//'` ;;
    *) optarg= ;;
    esac

    case $1 in
        --prefix=*)
            prefix=$optarg
            ;;
        --prefix)
            echo $prefix
            ;;
        --srcprefix=*)
            srcprefix=$optarg
            ;;
        --srcprefix)
            echo $srcprefix
            ;;
        --cflags)
            # Provide include path for ODE compatibility headers
            if [ "$type" = "DEVEL" ]; then
                if [ -d "$srcprefix/include/ode-dbl" ]; then
                    echo "$CBASEFLAGS -I$srcprefix/include/ode-dbl"
                else
                    echo "$CBASEFLAGS"
                fi
            else
                if [ -d "$prefix/@CMAKE_INSTALL_INCLUDEDIR@/ode-dbl" ]; then
                    echo "$CBASEFLAGS -I$prefix/@CMAKE_INSTALL_INCLUDEDIR@/ode-dbl"
                else
                    echo "$CBASEFLAGS"
                fi
            fi
            ;;
        --libs)
            # Return the ODE library
            echo "$ODE_LIBS"
            ;;
        *)
            echo "Syntax Error: $0 $@" 1>&2
            echo "${usage}" 1>&2
            exit 1
            ;;
    esac
    shift
done