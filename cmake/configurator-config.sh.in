#!/bin/sh
## File:     configurator-config for libconfigurator
## Author:   Georg Martius (original M4 version)
## CMake version: Generated from configurator-config.sh.in template
## Date:     @GENERATION_DATE@
## Version:  @PROJECT_VERSION@

# This file is generated by CMake from configurator-config.sh.in
# Do not edit this file directly

prefix="@CMAKE_INSTALL_PREFIX@"
srcprefix="@CMAKE_SOURCE_DIR@"
intern=
type="@LPZROBOTS_INSTALL_TYPE@"

# Set rpath based on install type
if [ "$type" = "DEVEL" ]; then
    rpath="-Wl,-rpath,$srcprefix:$srcprefix/selforg"
else
    rpath="-Wl,-rpath,$prefix/@CMAKE_INSTALL_LIBDIR@"
fi

LIBBASE=configurator

# Qt version and libraries
QT_VERSION="@QT_VERSION_MAJOR@"
QT_LIBS="@Qt${QT_VERSION_MAJOR}_LIBRARIES@"
HAS_QT="@LPZROBOTS_HAS_QT@"

# Base compiler flags
CBASEFLAGS="-std=c++17 -pthread"

# Add architecture flags on macOS
if [ "@CMAKE_SYSTEM_NAME@" = "Darwin" ]; then
    if [ "@CMAKE_OSX_ARCHITECTURES@" = "arm64" ]; then
        CBASEFLAGS="$CBASEFLAGS -arch arm64"
    fi
fi

CPPFLAGS="$CBASEFLAGS"
INTERNFLAGS="-g -O"
LIBS="-lm -lpthread"
STATIC=

usage="\
Usage: configurator-config [--prefix[=DIR]] [--srcprefix[=DIR]] [--version] [--intern] [--static] [--opt|--dbg] [--cflags] [--libs] [--libfile] [--solibfile] [--type]"

if test $# -eq 0; then
    echo "${usage}" 1>&2
    exit 1
fi

while test $# -gt 0; do
    case "$1" in
    -*=*) optarg=`echo "$1" | sed 's/[-_a-zA-Z0-9]*=//'` ;;
    *) optarg= ;;
    esac

    case $1 in
        --type)
            echo $type
            exit 0
            ;;
        --prefix=*)
            prefix=$optarg
            ;;
        --prefix)
            echo $prefix
            ;;
        --srcprefix=*)
            srcprefix=$optarg
            ;;
        --srcprefix)
            echo $srcprefix
            ;;
        --version)
            echo @PROJECT_VERSION@
            ;;
        --intern) ##for internal use when compiling the lib
            intern=1
            ;;
        --static) ##force use static linking of lib
            STATIC=--static
            if [ "@CMAKE_SYSTEM_NAME@" = "Linux" ]; then
                STATICSTART=-Wl,-Bstatic
                STATICEND=-Wl,-Bdynamic
            else
                # macOS doesn't support -Bstatic/-Bdynamic
                STATICSTART=
                STATICEND=
                USE_STATIC_LIBS=1
            fi
            rpath=""
            ;;
        --opt) ##Optimisation
            LIBBASE=${LIBBASE}_opt
            CPPFLAGS="$CBASEFLAGS -DNDEBUG"
            INTERNFLAGS="-O3"
            ;;
        --dbg) ## DEBUG
            LIBBASE=${LIBBASE}_dbg
            CPPFLAGS="$CBASEFLAGS -g"
            INTERNFLAGS="-g"
            ;;
        --cflags)
            if [ -z "$intern" ]; then INTERNFLAGS=; fi
            
            # Build include path
            if [ "$type" = "DEVEL" ]; then
                INCLUDES="-I$srcprefix -I$srcprefix/include -I$srcprefix/configurator/include"
            else
                INCLUDES="-I$prefix/@CMAKE_INSTALL_INCLUDEDIR@"
            fi
            
            # Get selforg cflags (configurator depends on selforg)
            if [ "$type" = "DEVEL" ]; then
                SELFORG_CFLAGS=`$srcprefix/selforg/selforg-config --cflags`
            else
                SELFORG_CFLAGS=`selforg-config --cflags 2>/dev/null || echo ""`
            fi
            
            # Get Qt flags if available
            QT_CFLAGS=""
            if [ "$HAS_QT" = "TRUE" ]; then
                if command -v pkg-config >/dev/null 2>&1; then
                    QT_CFLAGS=`pkg-config --cflags Qt${QT_VERSION}Core Qt${QT_VERSION}Widgets 2>/dev/null || echo ""`
                fi
            fi
            
            echo $CPPFLAGS $INCLUDES $SELFORG_CFLAGS $QT_CFLAGS $INTERNFLAGS
            ;;
        --libs)
            # Build library path
            if [ "$type" = "DEVEL" ]; then
                LIBPATH="-L$srcprefix/configurator"
            else
                LIBPATH="-L$prefix/@CMAKE_INSTALL_LIBDIR@"
            fi
            
            # Get selforg libs
            if [ "$type" = "DEVEL" ]; then
                SELFORG_LIBS=`$srcprefix/selforg/selforg-config --libs $STATIC`
            else
                SELFORG_LIBS=`selforg-config --libs $STATIC 2>/dev/null || echo "-lselforg"`
            fi
            
            # Get Qt libs if available
            QT_LIBS=""
            if [ "$HAS_QT" = "TRUE" ]; then
                if command -v pkg-config >/dev/null 2>&1; then
                    QT_LIBS=`pkg-config --libs Qt${QT_VERSION}Core Qt${QT_VERSION}Widgets 2>/dev/null || echo ""`
                fi
            fi
            
            # On macOS with --static, use explicit .a file paths
            if [ -n "$USE_STATIC_LIBS" ] && [ "@CMAKE_SYSTEM_NAME@" = "Darwin" ]; then
                if [ "$type" = "DEVEL" ]; then
                    LIBFILE="$srcprefix/configurator/lib${LIBBASE}.a"
                else
                    LIBFILE="$prefix/@CMAKE_INSTALL_LIBDIR@/lib${LIBBASE}.a"
                fi
                echo $LIBS $LIBFILE $SELFORG_LIBS $QT_LIBS
            else
                echo $LIBS $LIBPATH $rpath $STATICSTART -l$LIBBASE $STATICEND $SELFORG_LIBS $QT_LIBS
            fi
            ;;
        --libfile)
            if [ "$type" = "DEVEL" ]; then
                echo "$srcprefix/configurator/lib${LIBBASE}.a"
            else
                echo "$prefix/@CMAKE_INSTALL_LIBDIR@/lib${LIBBASE}.a"
            fi
            ;;
        --solibfile)
            if [ "$type" = "DEVEL" ]; then
                echo "$srcprefix/configurator/lib${LIBBASE}@CMAKE_SHARED_LIBRARY_SUFFIX@"
            else
                echo "$prefix/@CMAKE_INSTALL_LIBDIR@/lib${LIBBASE}@CMAKE_SHARED_LIBRARY_SUFFIX@"
            fi
            ;;
        *)
            echo "Syntax Error: $0 $@" 1>&2
            echo "${usage}" 1>&2
            exit 1
            ;;
    esac
    shift
done