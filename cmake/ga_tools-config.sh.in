#!/bin/sh
## File:     ga_tools-config for libga_tools
## Author:   Georg Martius (original M4 version)
## CMake version: Generated from ga_tools-config.sh.in template
## Date:     @GENERATION_DATE@
## Version:  @PROJECT_VERSION@

# This file is generated by CMake from ga_tools-config.sh.in
# Do not edit this file directly

prefix="@CMAKE_INSTALL_PREFIX@"
srcprefix="@CMAKE_SOURCE_DIR@"
intern=
type="@LPZROBOTS_INSTALL_TYPE@"

# Set rpath based on install type
if [ "$type" = "DEVEL" ]; then
    rpath="-Wl,-rpath,$srcprefix:$srcprefix/selforg"
else
    rpath="-Wl,-rpath,$prefix/@CMAKE_INSTALL_LIBDIR@"
fi

LIBBASE=ga_tools

# Base compiler flags
CBASEFLAGS="-std=c++17 -pthread"

# Add architecture flags on macOS
if [ "@CMAKE_SYSTEM_NAME@" = "Darwin" ]; then
    if [ "@CMAKE_OSX_ARCHITECTURES@" = "arm64" ]; then
        CBASEFLAGS="$CBASEFLAGS -arch arm64"
    fi
    
    # Handle include paths
    EXTRA_INCLUDES=""
    if [ -n "$LPZROBOTS_INCLUDE_PATH" ]; then
        EXTRA_INCLUDES="-I$LPZROBOTS_INCLUDE_PATH"
    else
        # Check for common macOS package manager paths
        # Use -isystem instead of -I to suppress warnings from external libraries
        if [ -d "/opt/homebrew/include" ]; then
            EXTRA_INCLUDES="$EXTRA_INCLUDES -isystem /opt/homebrew/include"
        fi
        if [ -d "/opt/local/include" ]; then
            EXTRA_INCLUDES="$EXTRA_INCLUDES -isystem /opt/local/include"
        fi
        if [ -d "/usr/local/include" ]; then
            EXTRA_INCLUDES="$EXTRA_INCLUDES -isystem /usr/local/include"
        fi
    fi
    CBASEFLAGS="$CBASEFLAGS $EXTRA_INCLUDES"
fi

CPPFLAGS="$CBASEFLAGS"
INTERNFLAGS="-g -O"
LIBS="-lm -lpthread"
STATIC=

usage="\
Usage: ga_tools-config [--prefix[=DIR]] [--srcprefix[=DIR]] [--version] [--intern] [--static] [--opt|--dbg] [--cflags] [--libs] [--libfile] [--solibfile] [--type] [--libs-noself]"

if test $# -eq 0; then
    echo "${usage}" 1>&2
    exit 1
fi

while test $# -gt 0; do
    case "$1" in
    -*=*) optarg=`echo "$1" | sed 's/[-_a-zA-Z0-9]*=//'` ;;
    *) optarg= ;;
    esac

    case $1 in
        --type)
            echo $type
            exit 0
            ;;
        --prefix=*)
            prefix=$optarg
            ;;
        --prefix)
            echo $prefix
            ;;
        --srcprefix=*)
            srcprefix=$optarg
            ;;
        --srcprefix)
            echo $srcprefix
            ;;
        --version)
            echo @PROJECT_VERSION@
            ;;
        --intern) ##for internal use when compiling the lib
            intern=1
            ;;
        --static) ##force use static linking of lib
            STATIC=--static
            if [ "@CMAKE_SYSTEM_NAME@" = "Linux" ]; then
                STATICSTART=-Wl,-Bstatic
                STATICEND=-Wl,-Bdynamic
            else
                # macOS doesn't support -Bstatic/-Bdynamic
                STATICSTART=
                STATICEND=
                USE_STATIC_LIBS=1
            fi
            rpath=""
            ;;
        --opt) ##Optimisation
            LIBBASE=${LIBBASE}_opt
            CPPFLAGS="$CBASEFLAGS -DNDEBUG"
            INTERNFLAGS="-O3"
            ;;
        --dbg) ## DEBUG
            LIBBASE=${LIBBASE}_dbg
            CPPFLAGS="$CBASEFLAGS -g"
            INTERNFLAGS="-g"
            ;;
        --cflags)
            if [ -z "$intern" ]; then INTERNFLAGS=; fi
            
            # Build include path
            if [ "$type" = "DEVEL" ]; then
                INCLUDES="-I$srcprefix -I$srcprefix/include -I$srcprefix/ga_tools/include"
            else
                INCLUDES="-I$prefix/@CMAKE_INSTALL_INCLUDEDIR@"
            fi
            
            # Get selforg cflags
            if [ "$type" = "DEVEL" ]; then
                SELFORG_CFLAGS=`$srcprefix/selforg/selforg-config --cflags`
            else
                SELFORG_CFLAGS=`selforg-config --cflags 2>/dev/null || echo ""`
            fi
            
            echo $CPPFLAGS $INCLUDES $SELFORG_CFLAGS $INTERNFLAGS
            ;;
        --libs|--libs-noself)
            # Build library path
            if [ "$type" = "DEVEL" ]; then
                LIBPATH="-L$srcprefix/ga_tools"
            else
                LIBPATH="-L$prefix/@CMAKE_INSTALL_LIBDIR@"
            fi
            
            # Get selforg libs unless --libs-noself
            SELFORG_LIBS=""
            if [ "$1" != "--libs-noself" ]; then
                if [ "$type" = "DEVEL" ]; then
                    SELFORG_LIBS=`$srcprefix/selforg/selforg-config --libs $STATIC`
                else
                    SELFORG_LIBS=`selforg-config --libs $STATIC 2>/dev/null || echo "-lselforg"`
                fi
            fi
            
            # On macOS with --static, use explicit .a file paths
            if [ -n "$USE_STATIC_LIBS" ] && [ "@CMAKE_SYSTEM_NAME@" = "Darwin" ]; then
                if [ "$type" = "DEVEL" ]; then
                    LIBFILE="$srcprefix/ga_tools/lib${LIBBASE}.a"
                else
                    LIBFILE="$prefix/@CMAKE_INSTALL_LIBDIR@/lib${LIBBASE}.a"
                fi
                echo $LIBS $LIBFILE $SELFORG_LIBS
            else
                echo $LIBS $LIBPATH $rpath $STATICSTART -l$LIBBASE $STATICEND $SELFORG_LIBS
            fi
            ;;
        --libfile)
            if [ "$type" = "DEVEL" ]; then
                echo "$srcprefix/ga_tools/lib${LIBBASE}.a"
            else
                echo "$prefix/@CMAKE_INSTALL_LIBDIR@/lib${LIBBASE}.a"
            fi
            ;;
        --solibfile)
            if [ "$type" = "DEVEL" ]; then
                echo "$srcprefix/ga_tools/lib${LIBBASE}@CMAKE_SHARED_LIBRARY_SUFFIX@"
            else
                echo "$prefix/@CMAKE_INSTALL_LIBDIR@/lib${LIBBASE}@CMAKE_SHARED_LIBRARY_SUFFIX@"
            fi
            ;;
        *)
            echo "Syntax Error: $0 $@" 1>&2
            echo "${usage}" 1>&2
            exit 1
            ;;
    esac
    shift
done