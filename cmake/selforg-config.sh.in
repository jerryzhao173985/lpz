#!/bin/sh
## File:     selforg-config for libselforg
## Author:   Georg Martius (original M4 version)
## CMake version: Generated from selforg-config.sh.in template
## Date:     @GENERATION_DATE@
## Version:  @PROJECT_VERSION@

# This file is generated by CMake from selforg-config.sh.in
# Do not edit this file directly

prefix="@CMAKE_INSTALL_PREFIX@"
srcprefix="@CMAKE_SOURCE_DIR@"
intern=
type="@LPZROBOTS_INSTALL_TYPE@"

# Set rpath based on install type
if [ "$type" = "DEVEL" ]; then
    rpath="-Wl,-rpath,$srcprefix"
else
    rpath="-Wl,-rpath,$prefix/@CMAKE_INSTALL_LIBDIR@"
fi

LIBBASE=selforg

# Base compiler flags
CBASEFLAGS="-std=c++17 -pthread"

# Add architecture flags on macOS
if [ "@CMAKE_SYSTEM_NAME@" = "Darwin" ]; then
    if [ "@CMAKE_OSX_ARCHITECTURES@" = "arm64" ]; then
        CBASEFLAGS="$CBASEFLAGS -arch arm64"
    fi
    
    # Handle include paths
    EXTRA_INCLUDES=""
    if [ -n "$LPZROBOTS_INCLUDE_PATH" ]; then
        EXTRA_INCLUDES="-I$LPZROBOTS_INCLUDE_PATH"
    else
        # Check for common macOS package manager paths
        # Use -isystem instead of -I to suppress warnings from external libraries
        if [ -d "/opt/homebrew/include" ]; then
            EXTRA_INCLUDES="$EXTRA_INCLUDES -isystem /opt/homebrew/include"
        fi
        if [ -d "/opt/local/include" ]; then
            EXTRA_INCLUDES="$EXTRA_INCLUDES -isystem /opt/local/include"
        fi
        if [ -d "/usr/local/include" ]; then
            EXTRA_INCLUDES="$EXTRA_INCLUDES -isystem /usr/local/include"
        fi
    fi
    CBASEFLAGS="$CBASEFLAGS $EXTRA_INCLUDES"
fi

CPPFLAGS="$CBASEFLAGS"
INTERNFLAGS="-g -O"
LIBS="-lm -lreadline -lncurses -lpthread"
STATIC=

# GSL support
GSL_CFLAGS="@GSL_CFLAGS@"
GSL_LIBS="@GSL_LDFLAGS@ @GSL_LIBRARIES@"
HAS_GSL="@GSL_FOUND@"

usage="\
Usage: selforg-config [--prefix[=DIR]] [--srcprefix[=DIR]] [--version] [--intern] [--static] [--opt|--dbg] [--cflags] [--libs] [--libfile] [--solibfile] [--type]"

if test $# -eq 0; then
    echo "${usage}" 1>&2
    exit 1
fi

while test $# -gt 0; do
    case "$1" in
    -*=*) optarg=`echo "$1" | sed 's/[-_a-zA-Z0-9]*=//'` ;;
    *) optarg= ;;
    esac

    case $1 in
        --type)
            echo $type
            exit 0
            ;;
        --prefix=*)
            prefix=$optarg
            ;;
        --prefix)
            echo $prefix
            ;;
        --srcprefix=*)
            srcprefix=$optarg
            ;;
        --srcprefix)
            echo $srcprefix
            ;;
        --version)
            echo @PROJECT_VERSION@
            ;;
        --intern) ##for internal use when compiling the lib
            intern=1
            ;;
        --static) ##force use static linking of lib
            STATIC=--static
            if [ "@CMAKE_SYSTEM_NAME@" = "Linux" ]; then
                STATICSTART=-Wl,-Bstatic
                STATICEND=-Wl,-Bdynamic
            else
                # macOS doesn't support -Bstatic/-Bdynamic
                STATICSTART=
                STATICEND=
                USE_STATIC_LIBS=1
            fi
            rpath=""
            ;;
        --opt) ##Optimisation
            LIBBASE=${LIBBASE}_opt
            CPPFLAGS="$CBASEFLAGS -DNDEBUG"
            INTERNFLAGS="-O3"
            ;;
        --dbg) ## DEBUG
            LIBBASE=${LIBBASE}_dbg
            CPPFLAGS="$CBASEFLAGS -g"
            INTERNFLAGS="-g"
            ;;
        --cflags)
            if [ -z "$intern" ]; then INTERNFLAGS=; fi
            # Always use NOCONFIGURATOR for components
            CONFIGURATORFLAGS=-DNOCONFIGURATOR
            
            # Build include path
            if [ "$type" = "DEVEL" ]; then
                INCLUDES="-I$srcprefix -I$srcprefix/include"
            else
                INCLUDES="-I$prefix/@CMAKE_INSTALL_INCLUDEDIR@"
            fi
            
            # Add GSL flags if available
            if [ "$HAS_GSL" = "TRUE" ]; then
                GSL_FLAGS="$GSL_CFLAGS"
            else
                GSL_FLAGS="-DNOGSL"
            fi
            
            echo $CPPFLAGS $INCLUDES $GSL_FLAGS $CONFIGURATORFLAGS $INTERNFLAGS
            ;;
        --libs)
            # Build library path
            if [ "$type" = "DEVEL" ]; then
                LIBPATH="-L$srcprefix"
            else
                LIBPATH="-L$prefix/@CMAKE_INSTALL_LIBDIR@"
            fi
            
            # On macOS with --static, use explicit .a file paths
            if [ -n "$USE_STATIC_LIBS" ] && [ "@CMAKE_SYSTEM_NAME@" = "Darwin" ]; then
                if [ "$type" = "DEVEL" ]; then
                    LIBFILE="$srcprefix/lib${LIBBASE}.a"
                else
                    LIBFILE="$prefix/@CMAKE_INSTALL_LIBDIR@/lib${LIBBASE}.a"
                fi
                # Add GSL libs if available
                if [ "$HAS_GSL" = "TRUE" ]; then
                    echo $LIBS $LIBFILE $GSL_LIBS
                else
                    echo $LIBS $LIBFILE
                fi
            else
                # Add GSL libs if available
                if [ "$HAS_GSL" = "TRUE" ]; then
                    echo $LIBS $LIBPATH $rpath $STATICSTART -l$LIBBASE $STATICEND $GSL_LIBS
                else
                    echo $LIBS $LIBPATH $rpath $STATICSTART -l$LIBBASE $STATICEND
                fi
            fi
            ;;
        --libfile)
            if [ "$type" = "DEVEL" ]; then
                echo "$srcprefix/lib${LIBBASE}.a"
            else
                echo "$prefix/@CMAKE_INSTALL_LIBDIR@/lib${LIBBASE}.a"
            fi
            ;;
        --solibfile)
            if [ "$type" = "DEVEL" ]; then
                echo "$srcprefix/lib${LIBBASE}@CMAKE_SHARED_LIBRARY_SUFFIX@"
            else
                echo "$prefix/@CMAKE_INSTALL_LIBDIR@/lib${LIBBASE}@CMAKE_SHARED_LIBRARY_SUFFIX@"
            fi
            ;;
        *)
            echo "Syntax Error: $0 $@" 1>&2
            echo "${usage}" 1>&2
            exit 1
            ;;
    esac
    shift
done