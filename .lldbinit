# LLDB initialization file for LPZRobots debugging
# Place in project root or copy to ~/.lldbinit

# Better formatting
settings set target.max-string-summary-length 1024
settings set target.max-memory-read-size 1024
settings set target.prefer-dynamic-value run-target
settings set target.process.thread.step-avoid-regexp ^std::
settings set frame-format "frame #${frame.index}: ${frame.pc}{ ${module.file.basename}{\`${function.name-with-args}{${frame.no-debug}${function.pc-offset}}}}{ at ${line.file.fullpath}:${line.number}:{${line.column}}}{${function.is-optimized} [opt]}\n"

# Auto-import the lldb module
script import lldb

# Python helper functions
python
import lldb
import re

def print_matrix(debugger, command, result, internal_dict):
    """Print a matrix in readable format"""
    args = command.split()
    if len(args) == 0:
        print("Usage: pmatrix <matrix_variable>")
        return
    
    target = debugger.GetSelectedTarget()
    process = target.GetProcess()
    thread = process.GetSelectedThread()
    frame = thread.GetSelectedFrame()
    
    mat = frame.FindVariable(args[0])
    if not mat.IsValid():
        mat = frame.EvaluateExpression(args[0])
    
    if not mat.IsValid():
        print(f"Could not find variable: {args[0]}")
        return
    
    rows = mat.GetChildMemberWithName("m").GetValueAsUnsigned()
    cols = mat.GetChildMemberWithName("n").GetValueAsUnsigned()
    data = mat.GetChildMemberWithName("data")
    
    print(f"Matrix {rows}x{cols}:")
    for i in range(rows):
        row_str = "["
        for j in range(cols):
            idx = i * cols + j
            val = data.GetChildAtIndex(idx).GetValue()
            row_str += f" {float(val):7.4f}"
        row_str += " ]"
        print(row_str)

def print_sensors(debugger, command, result, internal_dict):
    """Print robot sensor values"""
    args = command.split()
    if len(args) == 0:
        print("Usage: psensors <robot_pointer>")
        return
    
    target = debugger.GetSelectedTarget()
    process = target.GetProcess()
    thread = process.GetSelectedThread()
    frame = thread.GetSelectedFrame()
    
    robot = frame.FindVariable(args[0])
    if not robot.IsValid():
        robot = frame.EvaluateExpression(args[0])
    
    # Call getSensorNumber() method
    sensor_count = frame.EvaluateExpression(f"{args[0]}->getSensorNumber()").GetValueAsUnsigned()
    sensors = robot.GetChildMemberWithName("sensors")
    
    print(f"Robot sensors ({sensor_count}):")
    for i in range(sensor_count):
        val = sensors.GetChildAtIndex(i).GetValue()
        print(f"  [{i:2d}]: {float(val):7.4f}")

def print_motors(debugger, command, result, internal_dict):
    """Print robot motor values"""
    args = command.split()
    if len(args) == 0:
        print("Usage: pmotors <robot_pointer>")
        return
    
    target = debugger.GetSelectedTarget()
    process = target.GetProcess()
    thread = process.GetSelectedThread()
    frame = thread.GetSelectedFrame()
    
    robot = frame.FindVariable(args[0])
    if not robot.IsValid():
        robot = frame.EvaluateExpression(args[0])
    
    # Call getMotorNumber() method
    motor_count = frame.EvaluateExpression(f"{args[0]}->getMotorNumber()").GetValueAsUnsigned()
    motors = robot.GetChildMemberWithName("motors")
    
    print(f"Robot motors ({motor_count}):")
    for i in range(motor_count):
        val = motors.GetChildAtIndex(i).GetValue()
        print(f"  [{i:2d}]: {float(val):7.4f}")

def print_agent(debugger, command, result, internal_dict):
    """Print OdeAgent information"""
    args = command.split()
    if len(args) == 0:
        print("Usage: pagent <agent_pointer>")
        return
    
    target = debugger.GetSelectedTarget()
    process = target.GetProcess()
    thread = process.GetSelectedThread()
    frame = thread.GetSelectedFrame()
    
    agent = frame.FindVariable(args[0])
    if not agent.IsValid():
        agent = frame.EvaluateExpression(args[0])
    
    # Get agent name
    name = frame.EvaluateExpression(f"{args[0]}->getName()").GetSummary()
    robot_name = frame.EvaluateExpression(f"{args[0]}->getRobot()->getName()").GetSummary()
    controller_name = frame.EvaluateExpression(f"{args[0]}->getController()->getName()").GetSummary()
    step = agent.GetChildMemberWithName("t").GetValueAsUnsigned()
    
    print(f"Agent: {name}")
    print(f"  Robot: {robot_name}")
    print(f"  Controller: {controller_name}")
    print(f"  Step: {step}")

def lpz_catch_errors(debugger, command, result, internal_dict):
    """Set breakpoints on common error conditions"""
    debugger.HandleCommand('breakpoint set -E C++ -O "std::runtime_error"')
    debugger.HandleCommand('breakpoint set -E C++ -O "std::out_of_range"')
    debugger.HandleCommand('breakpoint set -E C++ -O "std::invalid_argument"')
    debugger.HandleCommand('breakpoint set -n abort')
    debugger.HandleCommand('breakpoint set -n __assert_fail')
    print("Error catching enabled")

def lpz_break_sim(debugger, command, result, internal_dict):
    """Set breakpoints at key simulation points"""
    debugger.HandleCommand('breakpoint set -n Simulation::start')
    debugger.HandleCommand('breakpoint set -n Simulation::loop')
    debugger.HandleCommand('breakpoint set -n OdeAgent::step')
    debugger.HandleCommand('breakpoint set -n AbstractController::step')
    print("Simulation breakpoints set")

# Register commands
def __lldb_init_module(debugger, internal_dict):
    debugger.HandleCommand('command script add -f lldbinit.print_matrix pmatrix')
    debugger.HandleCommand('command script add -f lldbinit.print_sensors psensors')
    debugger.HandleCommand('command script add -f lldbinit.print_motors pmotors')
    debugger.HandleCommand('command script add -f lldbinit.print_agent pagent')
    debugger.HandleCommand('command script add -f lldbinit.lpz_catch_errors lpz_catch_errors')
    debugger.HandleCommand('command script add -f lldbinit.lpz_break_sim lpz_break_sim')
    print("LPZRobots LLDB commands loaded")
    print("Useful commands:")
    print("  pmatrix <mat>  - Print matrix contents")
    print("  psensors <bot> - Print robot sensors")
    print("  pmotors <bot>  - Print robot motors")
    print("  pagent <agt>   - Print agent info")
    print("  lpz_catch_errors - Enable error catching")
    print("  lpz_break_sim  - Set simulation breakpoints")

end

# Type summaries for better display
type summary add -F lldbinit.matrix_summary matrix::Matrix
type summary add -F lldbinit.string_summary std::string

# Aliases
command alias pv print
command alias pd print -r
command alias ph print -f hex
command alias pb print -f binary

# Search paths for shared libraries
settings append target.exec-search-paths ./selforg ./ode_robots ./opende ./guilogger ./matrixviz

# Enable STL formatters
type category enable libcxx

# Startup message
script print("\nLPZRobots LLDB configuration loaded")